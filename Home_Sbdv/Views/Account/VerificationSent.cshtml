@{
    ViewData["Title"] = "Verification Email Sent";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Verification Email Sent</h4>
            </div>
            <div class="card-body text-center">
                <i class="bi bi-envelope-check" style="font-size: 3rem; color: #28a745;"></i>
                <h5 class="mt-3">Check Your Email</h5>
                <p>
                    We've sent a verification link to <strong>@ViewBag.Email</strong>.
                    Please check your inbox and click the verification link to activate your account.
                </p>
                <p class="text-muted small">
                    If you don't see the email, please check your spam folder.
                    The verification link will expire in 3 days.
                </p>
            </div>
            <div class="card-footer text-center">
                <p>Didn't receive the email?</p>
                <a asp-action="ResendVerification" asp-route-email="@ViewBag.Email" class="btn btn-outline-primary">Resend Verification Email</a>
                <div class="mt-3">
                    <a asp-action="Login">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>