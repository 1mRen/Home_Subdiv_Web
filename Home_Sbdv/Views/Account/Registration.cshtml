@model Home_Sbdv.Models.RegistrationViewModel

@{
    ViewData["Title"] = "Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration - HomeHive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/css/utilities/registration.css" rel="stylesheet" />
</head>
<body>

    <div class="container">
        <div class="inner-container">
            <h1>Sign up</h1>
            <p class="subtitle">Welcome! Enter your details below.</p>

            <!-- Validation Message -->
            <!-- Success message example -->
            @if (ViewBag.SuccessMessage != null)
            {
                <div id="message-alert" class="message-card success">
                    <span class="message-text">@ViewBag.SuccessMessage</span>
                    <button class="close-button">&times;</button>
                    <!-- Loading bar will be added by JavaScript -->
                </div>
            }

            <!-- Error message example -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div id="message-alert" class="message-card error">
                    <span class="message-text">@ViewBag.ErrorMessage</span>
                    <button class="close-button">&times;</button>
                    <!-- Loading bar will be added by JavaScript -->
                </div>
            }

            <!-- Or use a single message with type -->
            @if (ViewBag.Message != null)
            {
                <div id="message-alert" class="message-card @(ViewBag.MessageType == "error" ? "error" : "success")">
                    <span class="message-text">@ViewBag.Message</span>
                    <button class="close-button">&times;</button>
                    <!-- Loading bar will be added by JavaScript -->
                </div>
            }


            <!-- Form Start -->
            <form asp-action="Registration">
                <!-- First Name -->
                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <!-- Last Name -->
                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label asp-for="Email" class="control-label">Email address</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Contact Number -->
                <div class="form-group">
                    <label asp-for="ContactNumber" class="control-label"></label>
                    <input asp-for="ContactNumber" class="form-control" />
                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="form-group">
                    <label for="Address">Address</label>
                    <input type="text" asp-for="Address" class="form-control" required />
                </div>

                <!-- Gender -->
                <div class="form-group">
                    <label for="Gender">Gender</label>
                    <select asp-for="Gender" class="form-control" required>
                        <option value="" disabled selected hidden>-Select Gender--</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                    </select>
                </div>

                <!-- Ownership Status -->
                <div class="form-group">
                    <label for="OwnershipStatus">Do you own or rent the lot?</label>
                    <select asp-for="OwnershipStatus" class="form-control" required>
                        <option value="" disabled selected hidden>--Select Status</option>
                        <option value="owned">Owned</option>
                        <option value="rented">Rented</option>
                    </select>
                </div>

                <!-- Username -->
                <div class="form-group">
                    <label asp-for="Username" class="control-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

            <!-- Password -->
                        <div class="form-group">
                            <label asp-for="Password" class="control-label"></label>
                            <div class="password-input-wrapper">
                                <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                                <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                                    <i class="fa fa-eye-slash"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group">
                            <label>Confirm Password</label>
                            <div class="password-input-wrapper">
                                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                                <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                                    <i class="fa fa-eye-slash"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                <!-- Submit Button -->
                <div class="form-group">
                    <input type="submit" value="Sign up" class="btn btn-primary" />
                </div>
            </form>

            <!-- Login Link -->
            <div class="login-link">
                Already have an account? <a asp-action="Login">Sign in</a>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/message.js"></script>

</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
    }
}