@model Home_Sbdv.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - HomeHive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/utilities/login.css" rel="stylesheet" />
</head>
<body>
    <div class="split-screen">
     
        <!-- Right side with login form -->
        <div class="right-side p-1">
            <div class="form-container ">
                <h2>Sign in</h2>
                <p class="text-muted mb-4">Welcome back! Enter your details below.</p>
                
                <form asp-action="Login">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <!-- Email Field -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Email address</label>
                        <input asp-for="UserNameorEmail" class="form-control" placeholder="Your email address" />
                        <span asp-validation-for="UserNameorEmail" class="text-danger"></span>
                    </div>
                    
                    <!-- Password Field -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label">Password</label>
                            <a href="#" class="text-decoration-none small">Forgot password?</a>
                        </div>
                        <input asp-for="Password" class="form-control" placeholder="Password" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <!-- Remember me checkbox -->
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="rememberMe">
                        <label class="form-check-label text-muted" for="rememberMe">Keep me logged in</label>
                    </div>
                    
                    <!-- Submit Button -->
                    <button type="submit" class="submit-btn">Sign in</button>
                </form>
                
                <!-- OR divider -->
                <div class="divider">
                    <div class="divider-line"></div>
                    <div class="divider-text">OR</div>
                    <div class="divider-line"></div>
                </div>
                
                <!-- Social logins -->
                <div class="row g-2">
                <!-- Google Button -->
                <div class="col-6">
                    <button class="auth-provider-btn w-100" style="border-color: #e0e0e0;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="#DB4437">
                            <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                        </svg>
                        Google
                    </button>
                </div>

                <!-- Facebook Button -->
                <div class="col-6">
                    <button class="auth-provider-btn w-100" style="border-color: #e0e0e0;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="#1877F2">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.92 2.84 7.16 6.56 7.87v-5.57h-1.97v-2.3h1.97v-1.74c0-1.95 1.18-3.02 2.91-3.02.84 0 1.56.06 1.77.09v2.06h-1.22c-1.2 0-1.43.57-1.43 1.41v1.2h2.77l-.36 2.3h-2.41v5.57C13.16 15.16 16 11.92 16 8c0-4.42-3.58-8-8-8z"/>
                        </svg>
                        Facebook
                    </button>
                </div>

                <!-- Registration Link -->
                <div class="text-center mt-4">
                    Don't have an account? <a asp-action="Registration" class="text-decoration-none">Sign up</a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}