@model Home_Sbdv.Models.UserListViewModel

@{
    Layout = null;
    
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home Hive - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/utilities/admin.css" rel="stylesheet" />
</head>
<body data-theme="light">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-2 sidebar d-flex flex-column">
                <div class="d-flex align-items-center mb-4 px-3">
                    <img src="~/asset/logo-highlight.png" alt="Home Hive Logo" class="me-2 sidebar-logo">
                    <h4 class="mb-0">Home Hive</h4>
                </div>

                <div class="sidebar-menu flex-grow-1">
                    <div class="sidebar-item active">
                        <a asp-controller="Admin" asp-action="ListUsers"><i class="bi bi-people"></i> Users</a>
                    </div>
                    <div class="sidebar-item ">
                        <a asp-controller="Announcement" asp-action="AnnouncementList"><i class="bi bi-megaphone"></i> Announcement</a>
                    </div>
                    <div class="sidebar-item ">
                        <a asp-controller="Events" asp-action="EventList"><i class="bi bi-calendar-event"></i> Events</a>
                    </div>
                    <div class="sidebar-item">
                        <i class="bi bi-gear"></i> Settings
                    </div>
                    <div class="sidebar-item">
                        <a asp-controller="Facility" asp-action="FacilityList"><i class="bi bi-gear"></i> Facilities</a>
                    </div>
                </div>

                <div class="sidebar-logout p-3">
                    <form asp-controller="Account" asp-action="LogOut" method="post" id="logoutForm">
                        <button type="submit" class="btn btn-danger w-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </button>
                    </form>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-10">
                <h3 class="mt-3 p-3">
                    @(User.Identity != null && User.Identity.IsAuthenticated
                        ? $"{char.ToUpper(User.Identity.Name[0])}{User.Identity.Name.Substring(1)} Dashboard"
                        : "Admin Dashboard")
                </h3>

                <div class="dropdown mb-3">
                    <button class="btn btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        Timeframe: All-time
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Today</a></li>
                        <li><a class="dropdown-item" href="#">This Week</a></li>
                        <li><a class="dropdown-item" href="#">This Month</a></li>
                        <li><a class="dropdown-item" href="#">All-time</a></li>
                    </ul>
                </div>

                <!-- Load the ListUsers partial view -->
                @await Html.PartialAsync("~/Views/UserManagement/ListUsers.cshtml", Model)

            </div>

    </div>

        <!-- Night Mode -->
    <div class="night-mode-toggle">
        <button id="modeToggleBtn" class="btn d-flex justify-content-center align-items-center" aria-label="Toggle dark mode">
            <i id="modeIcon" class="bi bi-sun-fill fs-4"></i>
        </button>
    </div>
    
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>
