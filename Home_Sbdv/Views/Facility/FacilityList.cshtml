@model IEnumerable<Home_Sbdv.Models.FacilityViewModel>

@{
    ViewData["Title"] = "Facilities";
}
@if (User.Identity?.IsAuthenticated ?? false)
{
    <h2>Facilities</h2>

    <p>
        <a asp-action="Create" class="btn btn-success">Create New Facility</a>
    </p>

    <p>
        <a asp-controller="FacilityReservation" asp-action="FacilityReservationList" class="btn btn-primary">View Reservations</a>
    </p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Facility Name</th>
                <th>Description</th>
                <th>Location</th>
                <th>Availability Status</th>
                <th>Updated At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FacilityName</td>
                    <td>@item.Description</td>
                    <td>@item.Location</td>
                    <td>@item.AvailabilityStatus</td> <!-- Show Full Name Instead of ID -->
                    <td>
                        @if (item.UpdatedAt != null)
                        {
                            @item.UpdatedAt.Value.ToString("MM-dd-yyyy hh:mm tt")
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>
                  

                    <td>
                        <a asp-action="Details" asp-route-id="@item.FacilityId" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.FacilityId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.FacilityId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3 class="text-danger">You must be logged in to view events.</h3>
    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
}
