@model Home_Sbdv.Models.FacilityViewModel

@{
    ViewData["Title"] = "Create Facility";
}

<h2>Create new Facility</h2>


<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="FacilityName" class="form-label">Facility Name</label>
                <input asp-for="FacilityName" class="form-control" required />
                <span asp-validation-for="FacilityName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control" required />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AvailabilityStatus" class="form-label">Availability Status</label>
                <select asp-for="AvailabilityStatus" class="form-control" asp-items="ViewBag.AvailabilityStatusList">
                    <option value="">-- Select Status --</option>
                </select>
                <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
            </div>



            <button type="submit" class="btn btn-success">Create Facility</button>
            <a asp-action="FacilityList" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

