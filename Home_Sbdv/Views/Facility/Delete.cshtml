@model Home_Sbdv.Models.FacilityViewModel

@{
    ViewData["Title"] = "Delete Facility";
}

<h2>Are you sure you want to delete this facility?</h2>

<div class="card border-danger">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Facility Name:</dt>
            <dd class="col-sm-9">@Model.FacilityName</dd>

            <dt class="col-sm-3">Description:</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Location:</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3">Availability Status:</dt>
            <dd class="col-sm-9">@Model.AvailabilityStatus</dd>

            <dt class="col-sm-3">Last Updated:</dt>
            <dd class="col-sm-9">@Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss tt")</dd>
        </dl>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="FacilityId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="FacilityList" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
