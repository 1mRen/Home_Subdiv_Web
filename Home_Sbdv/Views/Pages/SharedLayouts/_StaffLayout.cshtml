@using System.Security.Claims
@model dynamic

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home Hive - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/utilities/admin.css" />
    <link rel="stylesheet" href="/Views/Pages/SharedLayouts/_AdminLayout.cshtml.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-theme="light">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-2 sidebar d-flex flex-column">
                <div class="d-flex align-items-center mb-4 px-3" style="max-height: 50px;">
                    <img src="~/asset/logo-highlight.png" alt="Home Hive Logo" class="me-2 sidebar-logo">
                    <h4 class="mb-0">Home Hive</h4>
                </div>
                <div class="sidebar-menu flex-grow-1">
                    <a asp-controller="Dashboard" asp-action="StaffDashboard" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "StaffDashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                    <a asp-controller="Announcement" asp-action="ManageAnnouncements" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "ManageAnnouncements" ? "active" : "")">
                        <i class="bi bi-megaphone"></i> Announcements
                    </a>
                    <a asp-controller="Event" asp-action="ManageEvents" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "ManageEvents" ? "active" : "")">
                        <i class="bi bi-calendar-event"></i> Events
                    </a>
                    <a asp-controller="FacilityReservation" asp-action="ManageReservations" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "ManageReservations" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i> Reservations
                    </a>
                    <a asp-controller="Facility" asp-action="ManageFacilities" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "ManageFacilities" ? "active" : "")">
                        <i class="bi bi-building"></i> Facilities
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "Profile" ? "active" : "")">
                        <i class="bi bi-person"></i> My Profile
                    </a>
                </div>
                <div class="sidebar-logout p-3">
                    <form asp-controller="Account" asp-action="LogOut" method="post" id="logoutForm">
                        <button type="submit" class="btn btn-danger w-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
            <!-- Main Content -->
            <div class="col-10 main-content">
                <div class="mobile-toggle d-md-none">
                    <button class="btn sidebar-toggle-btn">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </div>

                <h3 class="mt-3 p-3">
                    @(User.Identity != null && User.Identity.IsAuthenticated
                        ? $"Staff - {char.ToUpper(User.Identity.Name[0])}{User.Identity.Name.Substring(1)}"
                        : "Staff Dashboard") - @ViewData["Title"]
                </h3>

                @RenderBody()
            </div>
        </div>
        <!-- Night Mode Toggle -->
        <div class="night-mode-toggle">
            <button id="modeToggleBtn" class="btn d-flex justify-content-center align-items-center" aria-label="Toggle dark mode">
                <i id="modeIcon" class="bi bi-sun-fill fs-4"></i>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <script>
        // Mobile sidebar toggle
        document.querySelector('.sidebar-toggle-btn')?.addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('show');
            document.body.classList.toggle('sidebar-open');
        });

        // Night mode toggle
        document.getElementById('modeToggleBtn').addEventListener('click', function() {
            document.body.classList.toggle('night-mode');
            const modeIcon = document.getElementById('modeIcon');
            modeIcon.classList.toggle('bi-sun-fill');
            modeIcon.classList.toggle('bi-moon-fill');
            modeIcon.classList.add('rotate-animation');

            // Save preference
            const isDarkMode = document.body.classList.contains('night-mode');
            localStorage.setItem('nightMode', isDarkMode ? 'true' : 'false');

            setTimeout(() => {
                modeIcon.classList.remove('rotate-animation');
            }, 500);
        });

        // Check saved preference
        document.addEventListener('DOMContentLoaded', function() {
            const savedMode = localStorage.getItem('nightMode');
            if (savedMode === 'true') {
                document.body.classList.add('night-mode');
                document.getElementById('modeIcon').classList.remove('bi-sun-fill');
                document.getElementById('modeIcon').classList.add('bi-moon-fill');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>