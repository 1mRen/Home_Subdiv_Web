@using System.Security.Claims
@model dynamic

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home Hive - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/Views/Pages/SharedLayouts/_UserLayout.cshtml.css" />
    <link rel="stylesheet" href="~/css/nav/sidebar.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="sidebar d-flex flex-column">
                <!-- Logo and Brand -->
                <div class="logo-container">
                    <div class="new-logo">
                        <img src="~/asset/HH-logo-long.png" alt="HomeHive Logo" class="logo-img">
                    </div>
                </div>
                <!-- Navigation Menu -->
                <div class="sidebar-menu">
                    <a asp-controller="Dashboard" asp-action="HomeownerDashboard" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "HomeownerDashboard" ? "active" : "")">
                        <i class="bi bi-house-fill"></i> Dashboard
                    </a>
                    <a asp-controller="Announcement" asp-action="ViewAll" class="sidebar-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Announcement" && ViewContext.RouteData.Values["Action"].ToString() == "ViewAll" ? "active" : "")">
                        <i class="bi bi-megaphone"></i> Announcement
                    </a>
                    <a asp-controller="Event" asp-action="ViewAll" class="sidebar-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Event" && ViewContext.RouteData.Values["Action"].ToString() == "ViewAll" ? "active" : "")">
                        <i class="bi bi-calendar-event"></i> Events
                    </a>
                    <a asp-controller="Facility" asp-action="ViewAll" class="sidebar-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Facility" ? "active" : "")">
                        <i class="bi bi-flower3"></i> Facilities
                    </a>
                    <a asp-controller="FacilityReservation" asp-action="MyReservations" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "MyReservations" ? "active" : "")">
                        <i class="bi bi-calendar"></i> My Reservations
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="sidebar-item @(ViewContext.RouteData.Values["Action"].ToString() == "Profile" ? "active" : "")">
                        <i class="bi bi-person"></i> Profile
                    </a>
                </div>
                <!-- Logout Button at Bottom -->
                <div class="sidebar-bottom">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn logout-btn">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </div>
            </div>
            <!-- Main Content -->
            <div class="col-10 main-content">
                <div class="mobile-toggle d-md-none">
                    <button class="btn sidebar-toggle-btn">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </div>

                @RenderBody()
            </div>
        </div>
       
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>