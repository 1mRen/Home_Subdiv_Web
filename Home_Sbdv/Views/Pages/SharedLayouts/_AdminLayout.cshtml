<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Home Hive</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Link to the new admin layout CSS file -->
    <link rel="stylesheet" href="/css/ui/admin.css">
    <link rel="stylesheet" href="~/Views/Pages/SharedLayouts/_AdminLayout.cshtml.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex flex-column flex-lg-row h-100">
        <!-- Sidebar -->
        <div class="sidebar bg-light border-end">
            <div class="p-3">
                <h5 class="fw-bold mb-0 text-center">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none d-flex justify-content-center">
                        <img src="~/asset/HH-logo-long.png" alt="Home Hive" style="height: 40px; width: auto;" />
                    </a>
                </h5>
                <div class="admin-label text-center mt-1">Administrator Panel</div>
            </div>
            <div class="p-3 border-top border-bottom">
                <div class="small text-muted">System Administrator</div>
                <div class="fw-bold">@User.FindFirst("Name")?.Value</div>
            </div>
            <div class="p-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Action"].ToString() == "AdminDashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="AdminDashboard">
                            <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "UserManagement" ? "active" : "")"
                           asp-controller="UserManagement" asp-action="ListUsers">
                            <i class="bi bi-people-fill me-2"></i> Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "Announcement" ? "active" : "")"
                           asp-controller="Announcement" asp-action="AnnouncementList">
                            <i class="bi bi-megaphone-fill me-2"></i> Announcements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "Event" ? "active" : "")"
                           asp-controller="Event" asp-action="EventList">
                            <i class="bi bi-calendar-event-fill me-2"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "Facility" ? "active" : "")"
                           asp-controller="Facility" asp-action="FacilityList">
                            <i class="bi bi-building-fill me-2"></i> Facilities
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "FacilityReservation" ? "active" : "")"
                           asp-controller="FacilityReservation" asp-action="FacilityReservationList">
                            <i class="bi bi-calendar-check-fill me-2"></i> Reservations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "ServiceReq" ? "active" : "")"
                           asp-controller="ServiceReq" asp-action="AdminList">
                            <i class="bi bi-tools me-2"></i> Service Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Action"].ToString() == "Profile" ? "active" : "")"
                           asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ContactDirectory" ? "active" : "")"
                           asp-controller="ContactDirectory" asp-action="Index">
                            <i class="bi bi-telephone me-2"></i> Contact Directory
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"].ToString() == "VisitorPass" ? "active" : "")"
                           asp-controller="VisitorPass" asp-action="AdminList">
                            <i class="bi bi-person-walking me-2"></i> Visitor Passes
                        </a>
                    </li>
                    
                </ul>
            </div>
            <div class="mt-auto p-3 border-top">
                <a class="btn btn-outline-primary w-100" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content flex-grow-1 overflow-auto">
            <!-- Header -->
            <header class="bg-white border-bottom sticky-top">
                <div class="container-fluid d-flex justify-content-between align-items-center p-3">
                    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                    <div class="d-flex align-items-center">

                        <partial name="/Views/Pages/SharedLayouts/_NotificationPartial.cshtml" />

                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="py-4 px-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="border-top p-3 text-center text-muted">
                <div class="container-fluid">
                    <small>&copy; 2023 Home Hive. All rights reserved.</small>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Dark mode toggle
        document.addEventListener('DOMContentLoaded', function() {
            const darkModeToggle = document.getElementById('darkModeToggle');
            const darkModeIcon = document.getElementById('darkModeIcon');

            // Check if dark mode is enabled
            if (localStorage.getItem('darkMode') === 'true') {
                document.body.classList.add('dark-mode');
                darkModeIcon.classList.remove('bi-moon-stars');
                darkModeIcon.classList.add('bi-sun');
            }

            // Toggle dark mode
            darkModeToggle.addEventListener('click', function() {
                document.body.classList.toggle('dark-mode');
                const isDarkMode = document.body.classList.contains('dark-mode');

                // Update icon
                if (isDarkMode) {
                    darkModeIcon.classList.remove('bi-moon-stars');
                    darkModeIcon.classList.add('bi-sun');
                } else {
                    darkModeIcon.classList.remove('bi-sun');
                    darkModeIcon.classList.add('bi-moon-stars');
                }

                // Save preference
                localStorage.setItem('darkMode', isDarkMode);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>