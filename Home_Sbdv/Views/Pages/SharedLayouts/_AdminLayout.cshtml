<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Home Hive</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Add your custom admin styles here -->
    <link rel="stylesheet" href="~/Views/Pages/SharedLayouts/_AdminLayout.cshtml.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex flex-column flex-lg-row h-100">
        <!-- Sidebar -->
        <div class="sidebar bg-light border-end">
            <div class="p-3">
                <h5 class="fw-bold mb-0">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-house-fill me-2"></i>Home Hive
                    </a>
                </h5>
            </div>
            <div class="p-3 border-top border-bottom">
                <div class="small text-muted">System Administrator</div>
                <div class="fw-bold">Admin</div>
            </div>
            <div class="p-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="Dashboard" asp-action="AdminDashboard">
                            <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="UserManagement" asp-action="ListUsers">
                            <i class="bi bi-people-fill me-2"></i> Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="Announcement" asp-action="AnnouncementList">
                            <i class="bi bi-megaphone-fill me-2"></i> Announcements
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="Event" asp-action="EventList">
                            <i class="bi bi-calendar-event-fill me-2"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="Facility" asp-action="FacilityList">
                            <i class="bi bi-building-fill me-2"></i> Facilities
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="FacilityReservation" asp-action="FacilityReservationList">
                            <i class="bi bi-calendar-check-fill me-2"></i> Reservations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="ServiceReq" asp-action="AdminList">
                            <i class="bi bi-tools me-2"></i> Service Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center" asp-controller="Setting" asp-action="Index">
                            <i class="bi bi-gear-fill me-2"></i> Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Action"].ToString() == "Profile" ? "active" : "")"
                           asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ContactDirectory" ? "active" : "")"
                           asp-controller="ContactDirectory" asp-action="Index">
                            <i class="bi bi-telephone me-2"></i> Contact Directory
                        </a>
                    </li>
                </ul>
            </div>
            <div class="mt-auto p-3 border-top">
                <a class="btn btn-outline-secondary w-100" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content flex-grow-1 overflow-auto">
            <!-- Header -->
            <header class="bg-white border-bottom sticky-top">
                <div class="container-fluid d-flex justify-content-between align-items-center p-3">
                    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                    <div class="d-flex align-items-center">
                        <!-- You can add header elements like notifications, profile dropdown, etc. here -->
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="py-4">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="border-top p-3 text-center text-muted">
                <div class="container-fluid">
                    <small>&copy; 2023 Home Hive. All rights reserved.</small>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>