@model Home_Sbdv.Models.AnnouncementViewModel
@{
    ViewData["Title"] = "Announcement Details";
}

<div class="container-fluid px-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="StaffAnnouncementList">Announcements</a></li>
                <li class="breadcrumb-item active" aria-current="page">View Announcement</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Announcement Details</h5>
                <div>
                    <a asp-action="StaffEdit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Edit
                    </a>
                    <a asp-action="StaffAnnouncementList" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="announcement-header mb-4">
                <h3 class="mb-2">@Model.Title</h3>
                <div class="text-muted d-flex align-items-center flex-wrap gap-3">
                    <span><i class="bi bi-person me-1"></i> Posted by: @Model.PostedByUsername</span>
                    <span><i class="bi bi-calendar3 me-1"></i> Posted on: @Model.PostedAt.ToString("MMM dd, yyyy, HH:mm")</span>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <span><i class="bi bi-clock-history me-1"></i> Last updated: @Model.UpdatedAt?.ToString("MMM dd, yyyy, HH:mm")</span>
                    }
                    <span>
                        Status:
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                    </span>
                </div>
            </div>

            <div class="announcement-content mb-4">
                <div class="card">
                    <div class="card-body bg-light">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.AttachmentPath))
            {
                <div class="announcement-attachment mb-4">
                    <h5 class="mb-3">Attachment</h5>
                    <a href="@Model.AttachmentPath" class="btn btn-outline-primary" target="_blank">
                        <i class="bi bi-file-earmark me-1"></i> Download Attachment
                    </a>
                </div>
            }
        </div>
    </div>
</div>
