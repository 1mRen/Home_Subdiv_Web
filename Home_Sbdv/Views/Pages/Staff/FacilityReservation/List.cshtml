@model IEnumerable<Home_Sbdv.Models.FacilityReservationViewModel>
@using System.Security.Claims
@{
    ViewData["Title"] = "Facility Reservations";
    var currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Facility Reservations</h5>
            <div>
                <a asp-controller="Facility" asp-action="StaffFacilityList" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-building"></i> View Facilities
                </a>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Reservation
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Facility</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Reserved By</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model)
                            {
                                <tr>
                                    <td>@reservation.FacilityName</td>
                                    <td>@reservation.ReservationDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @{
                                            var startDateTime = DateTime.Today.Add(reservation.StartTime);
                                            var endDateTime = DateTime.Today.Add(reservation.EndTime);
                                        }
                                        @startDateTime.ToString("hh:mm tt") - @endDateTime.ToString("hh:mm tt")
                                    </td>
                                    <td>@reservation.CreatedByName</td>
                                    <td>
                                        @switch (reservation.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Approved":
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@reservation.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="FacilityReservation" asp-action="StaffDetails" asp-route-id="@reservation.ReservationId" 
                                               class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            @if (reservation.CanApprove(currentUserId))
                                            {
                                                <form asp-action="UpdateStatus" asp-route-id="@reservation.ReservationId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="status" value="Approved" />
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-check-circle"></i> Approve
                                                    </button>
                                                </form>
                                                <form asp-action="UpdateStatus" asp-route-id="@reservation.ReservationId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="status" value="Rejected" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-x-circle"></i> Reject
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No facility reservations found.
                </div>
            }
        </div>
    </div>
</div> 