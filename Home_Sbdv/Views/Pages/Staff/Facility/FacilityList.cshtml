@model IEnumerable<Home_Sbdv.Models.FacilityViewModel>
@{
    ViewData["Title"] = "Facilities";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Facilities</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var facility in Model)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <img src="@facility.DisplayImageUrl" alt="@facility.FacilityName" class="card-img-top" style="height: 180px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title">@facility.FacilityName</h5>
                                    <p class="card-text text-muted small mb-1">
                                        <i class="bi bi-geo-alt"></i> @facility.Location
                                    </p>
                                    <div class="mb-2">
                                        @if (facility.AvailabilityStatus == "Available")
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else if (facility.AvailabilityStatus == "Maintenance")
                                        {
                                            <span class="badge bg-warning text-dark">Under Maintenance</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Closed</span>
                                        }
                                    </div>
                                    <p class="card-text text-truncate">@facility.Description</p>
                                </div>
                                <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                                    <a asp-action="StaffDetails" asp-route-id="@facility.FacilityId" class="btn btn-sm btn-outline-primary">View</a>
                                    <a asp-action="EditStatus" asp-route-id="@facility.FacilityId" class="btn btn-sm btn-outline-warning">Edit Status</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted">No facilities found.</p>
                </div>
            }
        </div>
    </div>
</div> 