@model IEnumerable<Home_Sbdv.Models.FacilityViewModel>
@{
    ViewData["Title"] = "Facilities";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Facilities</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Facility Name</th>
                                <th>Description</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var facility in Model)
                            {
                                <tr>
                                    <td>@facility.FacilityName</td>
                                    <td>@facility.Description</td>
                                    <td>@facility.Location</td>
                                    <td>@facility.AvailabilityStatus</td>
                                    <td>
                                        <a asp-action="StaffDetails" asp-route-id="@facility.FacilityId" class="btn btn-sm btn-outline-primary">View</a>
                                        <a asp-action="EditStatus" asp-route-id="@facility.FacilityId" class="btn btn-sm btn-outline-warning">Edit Status</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted">No facilities found.</p>
                </div>
            }
        </div>
    </div>
</div> 