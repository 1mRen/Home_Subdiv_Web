@model Home_Sbdv.Models.FacilityViewModel
@{
    ViewData["Title"] = "Edit Facility Status";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Edit Facility Status</h5>
            <a asp-action="StaffFacilityList" class="btn btn-outline-secondary">Back to List</a>
        </div>
        <div class="card-body">
            <form asp-action="EditStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FacilityId" />
                <div class="mb-3">
                    <label asp-for="AvailabilityStatus" class="form-label">Status</label>
                    <select asp-for="AvailabilityStatus" class="form-select" asp-items="ViewBag.AvailabilityStatusList"></select>
                    <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Update Status</button>
                    <a asp-action="StaffFacilityList" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 