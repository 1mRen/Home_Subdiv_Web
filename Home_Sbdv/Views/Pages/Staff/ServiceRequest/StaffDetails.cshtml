@model Home_Sbdv.Models.ServiceReqViewModel
@{
    ViewData["Title"] = "Service Request Details";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Service Request Details</h5>
            <a asp-action="StaffList" class="btn btn-outline-secondary">Back to List</a>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">Request ID</dt>
                        <dd class="col-sm-9">@Model.RequestId</dd>

                        <dt class="col-sm-3">Request Type</dt>
                        <dd class="col-sm-9">@Model.Request_Type</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            <span class="badge @Model.GetStatusBadgeClass()">@Model.Status</span>
                        </dd>

                        <dt class="col-sm-3">Submitted By</dt>
                        <dd class="col-sm-9">@Model.SubmittedByName</dd>

                        <dt class="col-sm-3">Submitted At</dt>
                        <dd class="col-sm-9">@Model.GetFormattedSubmissionDate()</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        @if (Model.HasAttachment)
                        {
                            <dt class="col-sm-3">Attachment</dt>
                            <dd class="col-sm-9">
                                <a href="@Model.AttachmentUrl" class="btn btn-sm btn-outline-primary" target="_blank">
                                    <i class="fas fa-download"></i> Download Attachment
                                </a>
                            </dd>
                        }
                    </dl>
                </div>
                <div class="col-md-4">
                    @if (Model.HasImage)
                    {
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Proof Image</h6>
                            </div>
                            <div class="card-body">
                                <img src="@Model.ImageUrl" class="img-fluid rounded" alt="Proof Image" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                @if (Model.CanBeApproved)
                {
                    <form asp-action="Approve" asp-route-id="@Model.RequestId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success">Approve Request</button>
                    </form>
                }

                @if (Model.CanBeRejected)
                {
                    <form asp-action="Reject" asp-route-id="@Model.RequestId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Reject Request</button>
                    </form>
                }

                @if (Model.Status == "Approved")
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.RequestId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="InProgress" />
                        <button type="submit" class="btn btn-info">Mark as In Progress</button>
                    </form>
                }

                @if (Model.Status == "InProgress")
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.RequestId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="Completed" />
                        <button type="submit" class="btn btn-success">Mark as Completed</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>