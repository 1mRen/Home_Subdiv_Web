@model IEnumerable<Home_Sbdv.Models.EventViewModel>
@{
    ViewData["Title"] = "Events";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Events</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Location</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model)
                            {
                                <tr>
                                    <td>@ev.EventName</td>
                                    <td>@ev.EventDate.ToShortDateString()</td>
                                    <td>@ev.StartTime.ToString("hh\\:mm") - @ev.EndTime.ToString("hh\\:mm")</td>
                                    <td>@ev.Location</td>
                                    <td>
                                        <a asp-action="StaffDetails" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-primary">View</a>
                                        <a asp-action="StaffEdit" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-warning">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted">No events found.</p>
                </div>
            }
        </div>
    </div>
</div> 