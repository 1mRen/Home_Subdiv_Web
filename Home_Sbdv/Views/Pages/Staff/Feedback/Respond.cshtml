@model Home_Sbdv.Models.FeedbackResponseViewModel
@{
    ViewData["Title"] = "Respond to Feedback";
    var feedback = ViewBag.Feedback as Home_Sbdv.Models.FeedbackViewModel;
}

@functions {
    public string GetBadgeClass(string type)
    {
        return type.ToLower() switch
        {
            "complaint" => "bg-danger text-white",
            "suggestion" => "bg-info text-white",
            "question" => "bg-warning",
            "appreciation" => "bg-success text-white",
            _ => "bg-secondary text-white"
        };
    }

    public string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-warning",
            "in progress" => "bg-info text-white",
            "resolved" => "bg-success text-white",
            "closed" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6>Respond to Feedback #@feedback.Id</h6>
                    <div>
                        @if (User.IsInRole("admin"))
                        {
                            <a href="@Url.Action("AdminDetails", "Feedback", new { id = feedback.Id })" class="btn btn-secondary btn-sm">Back to Details</a>
                        }
                        else
                        {
                            <a href="@Url.Action("StaffDetails", "Feedback", new { id = feedback.Id })" class="btn btn-secondary btn-sm">Back to Details</a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul>
                                @foreach (var key in ViewData.ModelState.Keys)
                                {
                                    @foreach (var error in ViewData.ModelState[key].Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Feedback Information</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label text-sm">Title</label>
                                        <p class="font-weight-bold mb-1">@feedback.Title</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-sm">Type</label>
                                        <p><span class="badge @GetBadgeClass(feedback.Type)">@feedback.Type</span></p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-sm">Submitted By</label>
                                        <p class="mb-1">@feedback.SubmittedByName</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-sm">Submitted On</label>
                                        <p class="mb-1">@feedback.CreatedAt.ToString("MMMM dd, yyyy HH:mm")</p>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-sm">Current Status</label>
                                        <p><span class="badge badge-pill @GetStatusBadgeClass(feedback.Status)">@feedback.Status</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">Feedback Description</h6>
                                </div>
                                <div class="card-body">
                                    <pre style="white-space: pre-wrap; font-family: inherit;">@feedback.Description</pre>

                                    @if (!string.IsNullOrEmpty(feedback.AttachmentPath))
                                    {
                                        <div class="mt-3">
                                            <label class="form-label text-sm">Attachment</label>
                                            <div>
                                                <a href="@Url.Action("Download", "Feedback", new { id = feedback.Id })" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-download me-1"></i> Download Attachment
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <form method="post" action="@Url.Action("Respond", "Feedback", new { id = feedback.Id })" class="mt-4">
                        @Html.AntiForgeryToken()
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Your Response</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label asp-for="Status" class="form-label">Update Status</label>
                                    <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusList">
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="StaffResponse" class="form-label">Your Response</label>
                                    <textarea asp-for="StaffResponse" class="form-control" rows="6"
                                              placeholder="Provide your detailed response here...">@feedback.StaffResponse</textarea>
                                    <span asp-validation-for="StaffResponse" class="text-danger"></span>
                                    <div class="form-text">
                                        Please provide a clear and detailed response to address the feedback.
                                    </div>
                                </div>

                                <div class="mt-4 d-flex justify-content-end">
                                    @if (User.IsInRole("admin"))
                                    {
                                        <a href="@Url.Action("AdminDetails", "Feedback", new { id = feedback.Id })" class="btn btn-secondary me-2">
                                            Cancel
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("StaffDetails", "Feedback", new { id = feedback.Id })" class="btn btn-secondary me-2">
                                            Cancel
                                        </a>
                                    }
                                    <button type="submit" class="btn btn-primary">
                                        Submit Response
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>

                    @if (feedback.UpdatedAt != null && !string.IsNullOrEmpty(feedback.StaffResponse))
                    {
                        <div class="card mt-4">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Previous Response</h6>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <label class="form-label text-sm">Last Updated</label>
                                    <p class="mb-1">@feedback.UpdatedAt?.ToString("MMMM dd, yyyy HH:mm")</p>
                                </div>
                                <div>
                                    <label class="form-label text-sm">Response</label>
                                    <pre style="white-space: pre-wrap; font-family: inherit;">@feedback.StaffResponse</pre>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Add a confirmation dialog when changing status to Resolved or Closed
            $('form').on('submit', function(e) {
                var selectedStatus = $('#Status').val();
                if (selectedStatus === 'Resolved' || selectedStatus === 'Closed') {
                    if (!confirm('Are you sure you want to mark this feedback as ' + selectedStatus + '? This will finalize the status.')) {
                        e.preventDefault();
                        return false;
                    }
                }
            });

            // Add character count to response textarea
            var responseTextarea = $('#StaffResponse');
            responseTextarea.after('<div class="form-text text-end" id="charCount">0 characters</div>');

            responseTextarea.on('input', function() {
                $('#charCount').text($(this).val().length + ' characters');
            });

            // Trigger the input event to update the counter on page load
            responseTextarea.trigger('input');
        });
    </script>
}