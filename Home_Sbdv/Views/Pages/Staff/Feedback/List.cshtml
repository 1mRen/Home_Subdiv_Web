@model Home_Sbdv.Models.FeedbackListViewModel
@{
    ViewData["Title"] = "Assigned Feedbacks";
}

@functions {
    public string GetBadgeClass(string type)
    {
        return type.ToLower() switch
        {
            "complaint" => "bg-danger text-white",
            "suggestion" => "bg-info text-white",
            "question" => "bg-warning",
            "appreciation" => "bg-success text-white",
            _ => "bg-secondary text-white"
        };
    }

    public string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-warning",
            "in progress" => "bg-info text-white",
            "resolved" => "bg-success text-white",
            "closed" => "bg-secondary text-white",
            _ => "bg-secondary text-white"
        };
    }

    public string GetFeedbackIcon(string type)
    {
        return type.ToLower() switch
        {
            "complaint" => "fa-exclamation-circle",
            "suggestion" => "fa-lightbulb",
            "question" => "fa-question-circle",
            "appreciation" => "fa-thumbs-up",
            _ => "fa-comment"
        };
    }
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6>Assigned Feedbacks</h6>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    <div class="row px-4 pt-3">
                        <div class="col-md-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">Total Assigned</p>
                                            <h4 class="mb-0">@Model.TotalFeedbacks</h4>
                                        </div>
                                        <div class="avatar-sm rounded-circle bg-primary align-self-center mini-stat-icon">
                                            <span class="avatar-title rounded-circle bg-primary">
                                                <i class="fas fa-tasks font-size-24"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">Pending</p>
                                            <h4 class="mb-0">@Model.PendingFeedbacks</h4>
                                        </div>
                                        <div class="avatar-sm rounded-circle bg-warning align-self-center mini-stat-icon">
                                            <span class="avatar-title rounded-circle bg-warning">
                                                <i class="fas fa-clock font-size-24"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">In Progress</p>
                                            <h4 class="mb-0">@Model.InProgressFeedbacks</h4>
                                        </div>
                                        <div class="avatar-sm rounded-circle bg-info align-self-center mini-stat-icon">
                                            <span class="avatar-title rounded-circle bg-info">
                                                <i class="fas fa-spinner font-size-24"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">Resolved</p>
                                            <h4 class="mb-0">@Model.ResolvedFeedbacks</h4>
                                        </div>
                                        <div class="avatar-sm rounded-circle bg-success align-self-center mini-stat-icon">
                                            <span class="avatar-title rounded-circle bg-success">
                                                <i class="fas fa-check-circle font-size-24"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Feedbacks.Count == 0)
                    {
                        <div class="text-center py-5">
                            <div class="avatar-lg mx-auto mb-4">
                                <i class="fas fa-tasks fa-3x text-muted"></i>
                            </div>
                            <h5>No feedbacks assigned to you</h5>
                            <p class="text-muted">You don't have any feedback assigned to you at the moment.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">ID</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Title & Type</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Status</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Submitted By</th>
                                        <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Submitted Date</th>
                                        <th class="text-secondary opacity-7"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Feedbacks)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <p class="text-xs font-weight-bold mb-0">#@item.Id</p>
                                            </td>
                                            <td>
                                                <div class="d-flex px-2 py-1">
                                                    <div>
                                                        <div class="avatar avatar-sm me-3 bg-gradient-dark shadow-dark text-center">
                                                            <i class="fas @GetFeedbackIcon(item.Type) text-lg opacity-10" aria-hidden="true"></i>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex flex-column justify-content-center">
                                                        <h6 class="mb-0 text-sm">@item.Title</h6>
                                                        <p class="text-xs text-secondary mb-0">
                                                            <span class="badge @GetBadgeClass(item.Type)">@item.Type</span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge badge-pill @GetStatusBadgeClass(item.Status)">@item.Status</span>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">@item.SubmittedByName</p>
                                            </td>
                                            <td>
                                                <p class="text-xs font-weight-bold mb-0">@item.CreatedAt.ToString("MMM dd, yyyy")</p>
                                                <p class="text-xs text-secondary mb-0">@item.CreatedAt.ToString("HH:mm")</p>
                                            </td>
                                            <td class="align-middle">
                                                <div class="btn-group">
                                                    <a href="@Url.Action("StaffDetails", "Feedback", new { id = item.Id })" class="btn btn-link text-secondary text-xs">
                                                        <i class="fas fa-eye me-1"></i> Details
                                                    </a>
                                                    <a href="@Url.Action("Respond", "Feedback", new { id = item.Id })" class="btn btn-link text-primary text-xs">
                                                        <i class="fas fa-reply me-1"></i> Respond
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>