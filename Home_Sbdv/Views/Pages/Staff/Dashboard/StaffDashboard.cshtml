@model Home_Sbdv.Models.StaffDashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}
<div class="container-fluid px-4">
    <!-- Welcome & Date Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="mb-1">Welcome back, @User.FindFirst("Name")?.Value!</h4>
                            <p class="text-muted mb-0">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
                        </div>
                        <div class="text-end">
                            <div id="currentTime" class="fs-5 fw-bold"></div>
                            <div class="text-muted">Your local time</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Staff Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-transparent py-3">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a asp-controller="Announcement" asp-action="StaffAnnouncementList" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-megaphone text-primary fs-1"></i>
                                    <h6 class="mt-2">View Announcement</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Event" asp-action="Create" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-plus text-success fs-1"></i>
                                    <h6 class="mt-2">Create Event</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="FacilityReservation" asp-action="Create" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-check text-warning fs-1"></i>
                                    <h6 class="mt-2">Reserve Facility</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Account" asp-action="Profile" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-gear text-info fs-1"></i>
                                    <h6 class="mt-2">Update Profile</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="VisitorPass" asp-action="StaffList" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-walking text-danger fs-1"></i>
                                    <h6 class="mt-2">Visitor Passes</h6>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Management Stats -->
    <div class="row g-3 mb-4 justify-content-center">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-success text-white me-3">
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@(Model.RecentAnnouncements?.Count(a => a.IsPublished) ?? 0)</div>
                        <div class="text-muted">Published Announcements</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-orange text-white me-3">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@(Model.UpcomingEvents?.Count ?? 0)</div>
                        <div class="text-muted">Upcoming Events</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-pink text-white me-3">
                        <i class="bi bi-calendar-check-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@(Model.FacilityReservations?.Count ?? 0)</div>
                        <div class="text-muted">Active Reservations</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Content Row -->
    <div class="row g-4">
        <!-- All Announcements List -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">All Announcements</h5>
                    <div>

                        <a asp-controller="Announcement" asp-action="StaffAnnouncementList" class="btn btn-sm btn-outline-secondary">Manage</a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.RecentAnnouncements?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var announcement in Model.RecentAnnouncements)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">
                                            @announcement.Title
                                            @if (announcement.IsPublished)
                                            {
                                                <span class="badge bg-success ms-2">Published</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary ms-2">Draft</span>
                                            }
                                        </h6>
                                        <small class="text-muted">@announcement.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-1 text-truncate">@announcement.Content</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="text-muted">By: @announcement.PostedByUsername</small>
                                        <div class="btn-group">
                                            <a asp-controller="Announcement" asp-action="StaffDetails" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary">View</a>
                                            <a asp-controller="Announcement" asp-action="StaffEdit" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="Announcement" asp-action="AnnouncementList" class="btn btn-outline-primary">View All Announcements</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">No announcements found.</p>
                    }
                </div>
            </div>
        </div>
        <!-- Upcoming Events -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Upcoming Events</h5>
                    <a asp-controller="Event" asp-action="ManageEvents" class="btn btn-sm btn-outline-primary">Manage</a>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingEvents?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var evt in Model.UpcomingEvents)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@evt.EventName</h6>
                                        <small class="text-muted">@evt.Description</small>
                                    </div>
                                    <p class="mb-1 text-truncate">@evt.EventDate.ToString("MMM dd, yyyy")</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="text-muted">Location: @evt.Location</small>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Event" asp-action="Edit" asp-route-id="@evt.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <a asp-controller="Event" asp-action="Details" asp-route-id="@evt.EventId" class="btn btn-sm btn-outline-secondary">View</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="Event" asp-action="Create" class="btn btn-primary">Create New Event</a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="bi bi-calendar-plus text-muted" style="font-size: 3rem;"></i>
                            </div>
                            <p class="text-muted">There are no upcoming events.</p>
                            <a asp-controller="Event" asp-action="Create" class="btn btn-primary">Create Event</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- Recent Facility Reservations -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Facility Reservations</h5>
                    <a asp-controller="FacilityReservation" asp-action="ManageReservations" class="btn btn-sm btn-outline-primary">Manage All</a>
                </div>
                <div class="card-body">
                    @if (Model.FacilityReservations?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover staff-table">
                                <thead>
                                    <tr>
                                        <th>Facility</th>
                                        <th>Reserved By</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reservation in Model.FacilityReservations)
                                    {
                                        <tr>
                                            <td>@reservation.Facility.FacilityName</td>
                                            <td>@reservation.User.FullName</td>
                                            <td>@reservation.ReservationDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @{
                                                    var startDateTime = DateTime.Today.Add(reservation.StartTime);
                                                    var endDateTime = DateTime.Today.Add(reservation.EndTime);
                                                }
                                                @startDateTime.ToString("hh:mm tt") - @endDateTime.ToString("hh:mm tt")
                                            </td>
                                            <td>
                                                @switch (reservation.Status)
                                                {
                                                    case "Pending":
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                        break;
                                                    case "Approved":
                                                        <span class="badge bg-success">Approved</span>
                                                        break;
                                                    case "Rejected":
                                                        <span class="badge bg-danger">Rejected</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@reservation.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <a asp-controller="FacilityReservation" asp-action="View" asp-route-id="@reservation.ReservationId" class="btn btn-sm btn-outline-info">View</a>
                                                    <a asp-controller="FacilityReservation" asp-action="Edit" asp-route-id="@reservation.ReservationId" class="btn btn-sm btn-outline-primary">Update</a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">No facility reservations found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Update current time
        function updateTime() {
            const now = new Date();
            const timeElement = document.getElementById('currentTime');
            timeElement.textContent = now.toLocaleTimeString();
        }
        // Update time every second
        document.addEventListener('DOMContentLoaded', function() {
            updateTime();
            setInterval(updateTime, 1000);
            // Add some basic styling for announcement carousel
            const items = document.querySelectorAll('.announcement-carousel .alert');
            if (items.length > 1) {
                let currentIndex = 0;
                setInterval(() => {
                    items[currentIndex].classList.add('d-none');
                    currentIndex = (currentIndex + 1) % items.length;
                    items[currentIndex].classList.remove('d-none');
                }, 8000);
            }
        });
    </script>
}