@model Home_Sbdv.Models.FacilityViewModel
@{
    ViewData["Title"] = "Facility Details";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm">
        <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Facility Details</h5>
            <a asp-action="ViewAll" class="btn btn-outline-secondary">Back to List</a>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">Facility Name</dt>
                        <dd class="col-sm-9">@Model.FacilityName</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3">Location</dt>
                        <dd class="col-sm-9">@Model.Location</dd>

                        <dt class="col-sm-3">Capacity</dt>
                        <dd class="col-sm-9">@Model.Capacity</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            <span class="badge @(Model.AvailabilityStatus == "Available" ? "bg-success" : 
                                               Model.AvailabilityStatus == "Maintenance" ? "bg-warning" : "bg-danger")">
                                @Model.AvailabilityStatus
                            </span>
                        </dd>

                        <dt class="col-sm-3">Last Updated</dt>
                        <dd class="col-sm-9">@Model.UpdatedAt?.ToString("MMM dd, yyyy HH:mm")</dd>
                    </dl>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0">Facility Image</h6>
                        </div>
                        <div class="card-body">
                            <img src="@Model.DisplayImageUrl" class="img-fluid rounded" alt="@Model.FacilityName" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>