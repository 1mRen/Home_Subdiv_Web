@model Home_Sbdv.Models.FacilityViewModel
@{
    ViewData["Title"] = Model.FacilityName;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Facility" asp-action="ViewAll">Facilities</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.FacilityName</li>
        </ol>
    </nav>

    <div class="card shadow">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">@Model.FacilityName</h2>
            <div>
                @if (Model.AvailabilityStatus == "Available")
                {
                    <span class="badge bg-success">Available</span>
                }
                else if (Model.AvailabilityStatus == "Maintenance")
                {
                    <span class="badge bg-warning text-dark">Under Maintenance</span>
                }
                else
                {
                    <span class="badge bg-danger">Closed</span>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h4 class="mb-3">Description</h4>
                    <p class="mb-4">@Model.Description</p>

                    <h4 class="mb-3">Location</h4>
                    <p class="mb-4"><i class="bi bi-geo-alt"></i> @Model.Location</p>

                    <h4 class="mb-3">Last Updated</h4>
                    <p>@(Model.UpdatedAt?.ToString("MMMM dd, yyyy") ?? "N/A")</p>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.AvailabilityStatus == "Available")
                            {
                                <a asp-controller="FacilityReservation" asp-action="BookFacility" class="btn btn-primary btn-lg d-block mb-3">
                                    <i class="bi bi-calendar-plus me-2"></i> Book This Facility
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-lg d-block mb-3" disabled>
                                    <i class="bi bi-lock me-2"></i> Booking Unavailable
                                </button>
                            }
                            <a asp-action="ViewAll" class="btn btn-outline-secondary d-block">
                                <i class="bi bi-arrow-left me-2"></i> Back to Facilities
                            </a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Facility Status</h5>
                        </div>
                        <div class="card-body">
                            <p class="d-flex justify-content-between">
                                <span>Current Status:</span>
                                <strong>@Model.AvailabilityStatus</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>