@model List<Home_Sbdv.Models.FacilityViewModel>
@{
    ViewData["Title"] = "Facilities";
}

<div class="container py-5">
    <h1 class="text-center mb-4">Our Facilities</h1>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var facility in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@facility.FacilityName</h5>
                            <p class="card-text text-muted small mb-1">
                                <i class="bi bi-geo-alt"></i> @facility.Location
                            </p>
                            <div class="mb-3">
                                @if (facility.AvailabilityStatus == "Available")
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else if (facility.AvailabilityStatus == "Maintenance")
                                {
                                    <span class="badge bg-warning text-dark">Under Maintenance</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Closed</span>
                                }
                            </div>
                            <p class="card-text text-truncate">@facility.Description</p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="View" asp-route-id="@facility.FacilityId" class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                                @if (facility.AvailabilityStatus == "Available")
                                {
                                    <a asp-controller="FacilityReservation" asp-action="BookFacility" class="btn btn-sm btn-primary">Book Now</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No facilities available at the moment.
                </div>
            </div>
        }
    </div>
</div>