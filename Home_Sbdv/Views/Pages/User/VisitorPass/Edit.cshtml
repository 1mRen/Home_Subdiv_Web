@model Home_Sbdv.Models.VisitorPassRequestViewModel

@{
    ViewData["Title"] = "Edit Visitor Pass Request";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">Edit Visitor Pass Request</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="RequestedByUserId" />
                        <input type="hidden" asp-for="RequestedByUserName" />
                        <input type="hidden" asp-for="RequestedAt" />
                        <input type="hidden" asp-for="Status" />
                        <input type="hidden" asp-for="AuditTrail" />

                        <div class="mb-3">
                            <label asp-for="VisitorName" class="form-label">Visitor Name</label>
                            <input asp-for="VisitorName" class="form-control" />
                            <span asp-validation-for="VisitorName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VisitorContact" class="form-label">Contact Number</label>
                            <input asp-for="VisitorContact" class="form-control" />
                            <span asp-validation-for="VisitorContact" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Purpose" class="form-label">Purpose of Visit</label>
                            <textarea asp-for="Purpose" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Purpose" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VisitDate" class="form-label">Visit Date</label>
                            <input asp-for="VisitDate" class="form-control" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="VisitDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                Save Changes
                            </button>
                            <a asp-action="MyRequests" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Form submission handling
            $('#editForm').on('submit', function() {
                var submitBtn = $('#submitBtn');
                var spinner = submitBtn.find('.spinner-border');
                submitBtn.prop('disabled', true);
                spinner.removeClass('d-none');
            });

            // Set minimum date for visit date
            var today = new Date().toISOString().split('T')[0];
            $('#VisitDate').attr('min', today);
        });
    </script>
} 