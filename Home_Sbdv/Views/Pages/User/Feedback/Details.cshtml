@model Home_Sbdv.Models.FeedbackViewModel

@{
    ViewData["Title"] = "Feedback Details";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6>Feedback Details</h6>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="feedback-details">
                                <h2 class="mb-3">@Model.Title</h2>

                                <div class="d-flex mb-4">
                                    <div class="me-4">
                                        <span class="text-xs text-secondary mb-0">Type:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.Type</p>
                                    </div>
                                    <div class="me-4">
                                        <span class="text-xs text-secondary mb-0">Status:</span>
                                        <p class="text-sm mb-0">
                                            @{
                                                string badgeClass = Model.Status switch
                                                {
                                                    "Pending" => "bg-warning",
                                                    "In Progress" => "bg-info",
                                                    "Resolved" => "bg-success",
                                                    "Closed" => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@Model.Status</span>
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-xs text-secondary mb-0">Submitted:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h6 class="text-uppercase text-body text-xs font-weight-bolder">Description</h6>
                                    <div class="p-3 bg-light rounded">
                                        <p class="mb-0">@Model.Description</p>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                                {
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-body text-xs font-weight-bolder">Attachment</h6>
                                        <a href="@Url.Action("Download", "Feedback", new { id = Model.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-download me-2"></i>Download Attachment
                                        </a>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.StaffResponse))
                                {
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-body text-xs font-weight-bolder">Staff Response</h6>
                                        <div class="p-3 bg-light rounded border-left border-info">
                                            <p class="mb-0">@Model.StaffResponse</p>
                                        </div>
                                        <div class="text-end mt-2">
                                            <small class="text-muted">
                                                @if (Model.UpdatedAt.HasValue)
                                                {
                                                    <span>Responded on @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.AssignedToName))
                                                {
                                                    <span> by @Model.AssignedToName</span>
                                                }
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header pb-0">
                                    <h6>Status Timeline</h6>
                                </div>
                                <div class="card-body">
                                    <div class="timeline timeline-one-side">
                                        <div class="timeline-block mb-3">
                                            <span class="timeline-step bg-primary">
                                                <i class="ni ni-fat-add text-white"></i>
                                            </span>
                                            <div class="timeline-content">
                                                <h6 class="text-dark text-sm font-weight-bold mb-0">Feedback Created</h6>
                                                <p class="text-secondary font-weight-bold text-xs mt-1 mb-0">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                        </div>

                                        @if (Model.Status != "Pending")
                                        {
                                            <div class="timeline-block mb-3">
                                                <span class="timeline-step bg-info">
                                                    <i class="ni ni-user-run text-white"></i>
                                                </span>
                                                <div class="timeline-content">
                                                    <h6 class="text-dark text-sm font-weight-bold mb-0">In Progress</h6>
                                                    @if (!string.IsNullOrEmpty(Model.AssignedToName))
                                                    {
                                                        <p class="text-secondary text-xs mt-1 mb-0">Assigned to @Model.AssignedToName</p>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (Model.Status == "Resolved" || Model.Status == "Closed")
                                        {
                                            <div class="timeline-block mb-3">
                                                <span class="timeline-step @(Model.Status == "Resolved" ? "bg-success" : "bg-secondary")">
                                                    <i class="ni ni-check-bold text-white"></i>
                                                </span>
                                                <div class="timeline-content">
                                                    <h6 class="text-dark text-sm font-weight-bold mb-0">@Model.Status</h6>
                                                    @if (Model.UpdatedAt.HasValue)
                                                    {
                                                        <p class="text-secondary font-weight-bold text-xs mt-1 mb-0">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>