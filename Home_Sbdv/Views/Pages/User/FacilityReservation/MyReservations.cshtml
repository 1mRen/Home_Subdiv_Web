@model List<Home_Sbdv.Models.FacilityReservationViewModel>
@{
    ViewData["Title"] = "My Reservations";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">My Facility Reservations</h1>
    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-table me-1"></i>
                    My Reservations History
                </div>
                <div>
                    <a asp-action="BookFacility" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Book New Facility
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    You don't have any reservations yet. <a asp-action="BookFacility">Book a facility now</a>.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="myReservationsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Facility</th>
                                <th>Date</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reservation in Model)
                            {
                                <tr>
                                    <td>@reservation.FacilityName</td>
                                    <td>@reservation.ReservationDate.ToString("MMM dd, yyyy")</td>
                                    <td>@reservation.StartTime.ToString(@"hh\:mm tt")</td>
                                    <td>@reservation.EndTime.ToString(@"hh\:mm tt")</td>
                                    <td>
                                        @switch (reservation.Status)
                                        {
                                            case "Approved":
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@reservation.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (reservation.Status != "Approved")
                                        {
                                            <a asp-action="UserEdit" asp-route-id="@reservation.ReservationId" class="btn btn-sm btn-outline-primary me-1">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                        }
                                        <a asp-action="UserDelete" asp-route-id="@reservation.ReservationId" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i> Cancel
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#myReservationsTable').DataTable({
                order: [[1, 'desc'], [2, 'asc']], // Sort by date desc, then time asc
                responsive: true
            });
        });
    </script>
}