@model Home_Sbdv.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Event Details</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Home">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="ViewAll">Events</a></li>
        <li class="breadcrumb-item active">@Model.EventName</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-calendar-day me-1"></i>
                    Event Information
                </div>
                <div>
                    <span class="badge bg-primary">@Model.EventDate.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-8">
                    <h2 class="mb-3">@Model.EventName</h2>

                    <div class="mb-4">
                        <h5>Details</h5>
                        <div class="card">
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-3">Date</dt>
                                    <dd class="col-sm-9">@Model.EventDate.ToString("dddd, MMMM dd, yyyy")</dd>

                                    <dt class="col-sm-3">Time</dt>
                                    <dd class="col-sm-9">@Model.GetFormattedStartTime() - @Model.GetFormattedEndTime()</dd>

                                    <dt class="col-sm-3">Location</dt>
                                    <dd class="col-sm-9">@Model.Location</dd>

                                    <dt class="col-sm-3">Organizer</dt>
                                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.CreatedByName) ? "Community Admin" : Model.CreatedByName)</dd>

                                    @if (Model.LastUpdated.HasValue)
                                    {
                                        <dt class="col-sm-3">Last Updated</dt>
                                        <dd class="col-sm-9">@Model.LastUpdated.Value.ToString("MMM dd, yyyy hh:mm tt")</dd>
                                    }
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h5>Description</h5>
                        <div class="card">
                            <div class="card-body">
                                <p style="white-space: pre-line;">@Model.EventDescription</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <i class="fas fa-calendar me-1"></i> Event Calendar
                        </div>
                        <div class="card-body text-center">
                            <div class="calendar-display">
                                <div class="calendar-month">@Model.EventDate.ToString("MMMM")</div>
                                <div class="calendar-day">@Model.EventDate.Day</div>
                                <div class="calendar-year">@Model.EventDate.Year</div>
                            </div>
                            <hr />
                            <div class="event-time">
                                <i class="far fa-clock me-2"></i>
                                <span>@Model.GetFormattedStartTime() - @Model.GetFormattedEndTime()</span>
                            </div>
                            <div class="event-location mt-2">
                                <i class="fas fa-map-marker-alt me-2"></i>
                                <span>@Model.Location</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="ViewAll" class="btn btn-secondary w-100">
                            <i class="fas fa-arrow-left me-1"></i> Back to Events
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>