@model Home_Sbdv.Models.AnnouncementListViewModel
@{
    ViewData["Title"] = "Announcements";
    Layout = "/Views/Pages/SharedLayouts/_UserLayout.cshtml";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h2>Community Announcements</h2>
            <p class="text-muted">Stay updated with the latest community announcements.</p>
        </div>
    </div>

    @if (!Model.Announcements.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> There are no announcements available at this time.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var announcement in Model.Announcements)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@announcement.Title</h5>
                            <span class="badge bg-primary">
                                <i class="bi bi-calendar3"></i> @announcement.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                        </div>
                        <div class="card-body">
                            <p class="card-text">
                                @(announcement.Content.Length > 150
                                    ? announcement.Content.Substring(0, 150) + "..."
                                    : announcement.Content)
                            </p>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center bg-transparent">
                            <small class="text-muted">
                                By: @announcement.PostedByUsername
                            </small>
                            <a asp-controller="Announcement" asp-action="View" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                        @if (!string.IsNullOrEmpty(announcement.AttachmentPath))
                        {
                            <div class="card-footer bg-light">
                                <a href="@announcement.AttachmentPath" download class="btn btn-sm btn-outline-secondary w-100">
                                    <i class="bi bi-paperclip me-1"></i> Download Attachment
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>