```html
@model Home_Sbdv.Models.FeedbackViewModel
@{
    ViewData["Title"] = "Feedback Details";
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6>Feedback Details</h6>
                    <div>
                        <a href="@Url.Action("AdminList", "Feedback")" class="btn btn-secondary btn-sm">Back to List</a>
                        <a href="@Url.Action("Assign", "Feedback", new { id = Model.Id })" class="btn btn-primary btn-sm">Assign Staff</a>
                        <a href="@Url.Action("Respond", "Feedback", new { id = Model.Id })" class="btn btn-info btn-sm">Respond</a>
                        <a href="@Url.Action("Delete", "Feedback", new { id = Model.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="feedback-details">
                                <h2 class="mb-3">@Model.Title</h2>

                                <div class="d-flex flex-wrap mb-4">
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">ID:</span>
                                        <p class="text-sm mb-0 font-weight-bold">#@Model.Id</p>
                                    </div>
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">Type:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.Type</p>
                                    </div>
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">Status:</span>
                                        <p class="text-sm mb-0">
                                            @{
                                                string badgeClass = Model.Status switch
                                                {
                                                    "Pending" => "bg-warning",
                                                    "In Progress" => "bg-info",
                                                    "Resolved" => "bg-success",
                                                    "Closed" => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@Model.Status</span>
                                        </p>
                                    </div>
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">Submitted By:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.SubmittedByName</p>
                                    </div>
                                    <div>
                                        <span class="text-xs text-secondary mb-0">Submitted On:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h6 class="text-uppercase text-body text-xs font-weight-bolder">Description</h6>
                                    <div class="p-3 border rounded">
                                        <p class="mb-0">@Model.Description</p>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                                {
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-body text-xs font-weight-bolder">Attachment</h6>
                                        <div class="p-3 border rounded">
                                            <a href="@Url.Action("Download", "Feedback", new { id = Model.Id })" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-download me-2"></i>Download Attachment
                                            </a>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(Model.StaffResponse))
                                {
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-body text-xs font-weight-bolder">Staff Response</h6>
                                        <div class="p-3 border rounded">
                                            <p class="mb-0">@Model.StaffResponse</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header pb-0">
                                    <h6>Assignment Details</h6>
                                </div>
                                <div class="card-body">
                                    @if (Model.AssignedToId.HasValue)
                                    {
                                        <div class="mb-3">
                                            <span class="text-xs text-secondary mb-0">Assigned To:</span>
                                            <p class="text-sm mb-0 font-weight-bold">@Model.AssignedToName</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <span class="text-sm">This feedback is not assigned to any staff member yet.</span>
                                        </div>
                                        <a href="@Url.Action("Assign", "Feedback", new { id = Model.Id })" class="btn btn-primary btn-sm w-100">
                                            Assign to Staff
                                        </a>
                                    }

                                    <hr class="horizontal dark my-3">

                                    <div class="timeline">
                                        <div class="timeline-item">
                                            <div class="timeline-item-content">
                                                <span class="text-xs text-secondary">Created</span>
                                                <p class="text-xs font-weight-bold mt-n1">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                        </div>
                                        @if (Model.UpdatedAt.HasValue)
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-item-content">
                                                    <span class="text-xs text-secondary">Last Updated</span>
                                                    <p class="text-xs font-weight-bold mt-n1">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
```