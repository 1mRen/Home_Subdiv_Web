```html
@model Home_Sbdv.Models.FeedbackViewModel
@{
    ViewData["Title"] = "Delete Feedback";
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6>Delete Feedback</h6>
                    <div>
                        <a href="@Url.Action("AdminDetails", "Feedback", new { id = Model.Id })" class="btn btn-secondary btn-sm">Back to Details</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h5 class="alert-heading">Warning!</h5>
                        <p>Are you sure you want to delete this feedback? This action cannot be undone.</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="feedback-details">
                                <h2 class="mb-3">@Model.Title</h2>

                                <div class="d-flex flex-wrap mb-4">
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">ID:</span>
                                        <p class="text-sm mb-0 font-weight-bold">#@Model.Id</p>
                                    </div>
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">Type:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.Type</p>
                                    </div>
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">Status:</span>
                                        <p class="text-sm mb-0">
                                            @{
                                                string badgeClass = Model.Status switch
                                                {
                                                    "Pending" => "bg-warning",
                                                    "In Progress" => "bg-info",
                                                    "Resolved" => "bg-success",
                                                    "Closed" => "bg-secondary",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@Model.Status</span>
                                        </p>
                                    </div>
                                    <div class="me-4 mb-2">
                                        <span class="text-xs text-secondary mb-0">Submitted By:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.SubmittedByName</p>
                                    </div>
                                    <div>
                                        <span class="text-xs text-secondary mb-0">Submitted On:</span>
                                        <p class="text-sm mb-0 font-weight-bold">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h6 class="text-uppercase text-body text-xs font-weight-bolder">Description</h6>
                                    <div class="p-3 border rounded">
                                        <p class="mb-0">@Model.Description</p>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.StaffResponse))
                                {
                                    <div class="mb-4">
                                        <h6 class="text-uppercase text-body text-xs font-weight-bolder">Staff Response</h6>
                                        <div class="p-3 border rounded">
                                            <p class="mb-0">@Model.StaffResponse</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" asp-controller="Feedback" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end">
                            <a href="@Url.Action("AdminDetails", "Feedback", new { id = Model.Id })" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
```