@model Home_Sbdv.Models.EventViewModel
@{
    ViewData["Title"] = "Delete Event";
}
<h2 class="text-danger">Are you sure you want to delete this event?</h2>
<div class="card border-danger">
    <div class="card-body">
        <h5 class="card-title text-danger">@Model.EventName</h5>
        <p class="card-text"><strong>Description:</strong> @Model.Description</p>
        <p class="card-text"><strong>Location:</strong> @(string.IsNullOrEmpty(Model.Location) ? "No location specified" : Model.Location)</p>
        <p class="card-text"><strong>Date:</strong> @Model.EventDate.ToString("MMMM dd, yyyy")</p>
        <p class="card-text"><strong>Time:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</p>
        <p class="card-text"><strong>Created By:</strong> @Model.CreatedByName</p>
    </div>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EventId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="EventList" class="btn btn-secondary">Cancel</a>
</form>