@model IEnumerable<Home_Sbdv.Models.EventViewModel>

@{
    ViewData["Title"] = "Events";
}

@if (User.Identity?.IsAuthenticated ?? false)
{
    <h2>Events</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Event</a>
    </p>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Description</th>
                <th>Event Date</th>
                <th>Created By</th>
                <th>Last Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.EventDescription</td>
                    <td>@item.EventDate.ToString("MM-dd-yyyy hh:mm tt")</td>
                    <td>@item.CreatedByName</td> <!-- Show Full Name Instead of ID -->
                    <td>
                        @if (item.LastUpdated != null)
                        {
                            @item.LastUpdated.Value.ToString("MM-dd-yyyy hh:mm tt")
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3 class="text-danger">You must be logged in to view events.</h3>
    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
}
