@model Home_Sbdv.Models.AnnouncementViewModel
@{
    ViewData["Title"] = "Announcement Details";
}
<h2>Announcement Details</h2>
<div class="card shadow-lg p-4">
    <h4>@Model.Title</h4>
    <p><strong>Posted By:</strong> @Model.PostedByUsername</p>
    <p><strong>Posted At:</strong> @Model.PostedAt.ToString("MM-dd-yyyy hh:mm tt")</p>
    @if (Model.UpdatedAt != null)
    {
        <p><strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("MM-dd-yyyy hh:mm tt")</p>
    }
    <hr />
    <p>@Model.Content</p>
</div>
<a asp-action="AnnouncementList" class="btn btn-secondary mt-3">Back to List</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Edit</a>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger mt-3">Delete</a>