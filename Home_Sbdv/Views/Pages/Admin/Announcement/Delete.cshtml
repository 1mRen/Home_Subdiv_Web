@model Home_Sbdv.Models.AnnouncementViewModel
@{
    ViewData["Title"] = "Delete Announcement";
}
<h2>Are you sure you want to delete this announcement?</h2>
<div class="card shadow-lg p-4">
    <h4>@Model.Title</h4>
    <p><strong>Posted By:</strong> @Model.PostedByUsername</p>
    <p><strong>Posted At:</strong> @Model.CreatedAt.ToString("MM-dd-yyyy hh:mm tt")</p>
    @if (Model.UpdatedAt != null)
    {
        <p><strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("MM-dd-yyyy hh:mm tt")</p>
    }
    <hr />
    <p>@Model.Content</p>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger mt-3">Confirm Delete</button>
    <a asp-action="AnnouncementList" class="btn btn-secondary mt-3">Cancel</a>
</form>