@model Home_Sbdv.Models.FacilityReservationViewModel

@{
    ViewData["Title"] = "Facility Reservation Details";
}

<h2>Facility Reservation Details</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Facility:</dt>
            <dd class="col-sm-9">@Model.FacilityName</dd>

            <dt class="col-sm-3">Reservation Date:</dt>
            <dd class="col-sm-9">@Model.ReservationDate.ToString("MM-dd-yyyy")</dd>

            <dt class="col-sm-3">Start Time:</dt>
            <dd class="col-sm-9">@Model.StartTime.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-3">End Time:</dt>
            <dd class="col-sm-9">@Model.EndTime.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Created By:</dt>
            <dd class="col-sm-9">@Model.CreatedByName</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.ReservationId" class="btn btn-warning">Edit</a>
        <a asp-action="FacilityReservationList" class="btn btn-secondary">Back to List</a>
    </div>
</div>
