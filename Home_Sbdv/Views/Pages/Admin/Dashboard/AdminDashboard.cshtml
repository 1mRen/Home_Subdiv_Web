@model Home_Sbdv.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    // Remove the duplicate layout declaration since it's already in _ViewStart.cshtml
}

<div class="container-fluid px-4">
    <!-- Stats Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-primary text-white me-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@Model.TotalUsers</div>
                        <div class="text-muted">Total Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-warning text-white me-3">
                        <i class="bi bi-person-exclamation fs-4"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@Model.UnverifiedUsers</div>
                        <div class="text-muted">Unverified Users</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-purple text-white me-3">
                        <i class="bi bi-megaphone-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@Model.TotalAnnouncements</div>
                        <div class="text-muted">Announcements</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="icon-circle bg-teal text-white me-3">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="display-6 fw-bold">@(Model.UpcomingEvents?.Count ?? 0)</div>
                        <div class="text-muted">Upcoming Events</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->
    <div class="row g-4">
        <!-- Recent Announcements -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-transparent py-3">
                    <h5 class="mb-0">Recent Announcements</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentAnnouncements?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var announcement in Model.RecentAnnouncements)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@announcement.Title</h6>
                                        <small class="text-muted">@announcement.PostedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-1 text-truncate">@announcement.Content</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="text-muted">By: @announcement.PostedByUsername</small>
                                        <a asp-controller="Announcement" asp-action="Details" asp-route-id="@announcement.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="Announcement" asp-action="AnnouncementList" class="btn btn-outline-primary">View All Announcements</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">No recent announcements found.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Upcoming Events -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-transparent py-3">
                    <h5 class="mb-0">Upcoming Events</h5>
                </div>
                <div class="card-body">
                    @if (Model.UpcomingEvents?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var evt in Model.UpcomingEvents)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@evt.EventName</h6>
                                        <small class="text-muted">@evt.EventDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-1 text-truncate">@evt.Description</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="text-muted">Location: @evt.Location</small>
                                        <a asp-controller="Event" asp-action="Details" asp-route-id="@evt.EventId" class="btn btn-sm btn-outline-primary">View</a>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="text-center mt-3">
                            <a asp-controller="Event" asp-action="Index" class="btn btn-outline-primary">View All Events</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">No upcoming events found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-transparent py-3">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a asp-controller="UserManagement" asp-action="Create" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-person-plus-fill text-primary fs-1"></i>
                                    <h6 class="mt-2">Add New User</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Announcement" asp-action="Create" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-megaphone text-warning fs-1"></i>
                                    <h6 class="mt-2">Create Announcement</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Event" asp-action="Create" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-plus text-success fs-1"></i>
                                    <h6 class="mt-2">Create Event</h6>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Facility" asp-action="Create" class="card h-100 text-decoration-none text-dark card-hover">
                                <div class="card-body text-center">
                                    <i class="bi bi-building-add text-info fs-1"></i>
                                    <h6 class="mt-2">Add Facility</h6>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Any dashboard-specific JavaScript can go here
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Admin Dashboard loaded');
        });
    </script>
}