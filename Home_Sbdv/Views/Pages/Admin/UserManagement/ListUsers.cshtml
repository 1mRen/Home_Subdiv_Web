@model Home_Sbdv.Models.UserListViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid">
   

    <div class="d-flex justify-content-between mb-3">
        <div>
            <a asp-controller="UserManagement" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Create New User
            </a>
        </div>

        <div class="d-flex">
            <form asp-controller="UserManagement" asp-action="ListUsers" method="get" class="d-flex">
                <div class="input-group me-2">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search users..."
                           value="@Model.SearchTerm">
                    <button class="btn btn-outline-secondary" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>

                <select name="roleFilter" class="form-select me-2" onchange="this.form.submit()">
                    <option value="all" selected="@(Model.RoleFilter == "all")">All Roles</option>
                    <option value="admin" selected="@(Model.RoleFilter == "admin")">Admin</option>
                    <option value="homeowner" selected="@(Model.RoleFilter == "homeowner")">Homeowner</option>
                    <option value="staff" selected="@(Model.RoleFilter == "staff")">Staff</option>
                </select>

                <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
                <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
                <input type="hidden" name="page" value="@Model.Pagination.CurrentPage" />
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>
                        <a asp-controller="UserManagement" asp-action="ListUsers"
                           asp-route-sortColumn="LastName"
                           asp-route-sortOrder="@(Model.SortColumn == "LastName" && Model.SortOrder == "asc" ? "desc" : "asc")"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           asp-route-page="@Model.Pagination.CurrentPage">
                            Name
                            @if (Model.SortColumn == "LastName")
                            {
                                <i class="bi @(Model.SortOrder == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up")"></i>
                            }
                        </a>
                    </th>
                    <th>
                        <a asp-controller="UserManagement" asp-action="ListUsers"
                           asp-route-sortColumn="Email"
                           asp-route-sortOrder="@(Model.SortColumn == "Email" && Model.SortOrder == "asc" ? "desc" : "asc")"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           asp-route-page="@Model.Pagination.CurrentPage">
                            Email
                            @if (Model.SortColumn == "Email")
                            {
                                <i class="bi @(Model.SortOrder == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up")"></i>
                            }
                        </a>
                    </th>
                    <th>
                        <a asp-controller="UserManagement" asp-action="ListUsers"
                           asp-route-sortColumn="Username"
                           asp-route-sortOrder="@(Model.SortColumn == "Username" && Model.SortOrder == "asc" ? "desc" : "asc")"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           asp-route-page="@Model.Pagination.CurrentPage">
                            Username
                            @if (Model.SortColumn == "Username")
                            {
                                <i class="bi @(Model.SortOrder == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up")"></i>
                            }
                        </a>
                    </th>
                    <th>
                        <a asp-controller="UserManagement" asp-action="ListUsers"
                           asp-route-sortColumn="Role"
                           asp-route-sortOrder="@(Model.SortColumn == "Role" && Model.SortOrder == "asc" ? "desc" : "asc")"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           asp-route-page="@Model.Pagination.CurrentPage">
                            Role
                            @if (Model.SortColumn == "Role")
                            {
                                <i class="bi @(Model.SortOrder == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up")"></i>
                            }
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Username</td>
                        <td>
                            <span class="badge bg-@(user.Role == "admin" ? "danger" : user.Role == "staff" ? "primary" : "success")">
                                @user.Role
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="UserManagement" asp-action="Details" asp-route-id="@user.Id" class="btn btn-info">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <a asp-controller="UserManagement" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-controller="UserManagement" asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-3">No users found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.Pagination.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Pagination.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="UserManagement"
                       asp-action="ListUsers"
                       asp-route-page="1"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-roleFilter="@Model.RoleFilter">
                        First
                    </a>
                </li>
                <li class="page-item @(Model.Pagination.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="UserManagement"
                       asp-action="ListUsers"
                       asp-route-page="@(Model.Pagination.CurrentPage - 1)"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-roleFilter="@Model.RoleFilter">
                        &laquo;
                    </a>
                </li>

                @for (int i = Math.Max(1, Model.Pagination.CurrentPage - 2);
               i <= Math.Min(Model.Pagination.TotalPages, Model.Pagination.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.Pagination.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="UserManagement"
                           asp-action="ListUsers"
                           asp-route-page="@i"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.Pagination.CurrentPage == Model.Pagination.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="UserManagement"
                       asp-action="ListUsers"
                       asp-route-page="@(Model.Pagination.CurrentPage + 1)"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-roleFilter="@Model.RoleFilter">
                        &raquo;
                    </a>
                </li>
                <li class="page-item @(Model.Pagination.CurrentPage == Model.Pagination.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="UserManagement"
                       asp-action="ListUsers"
                       asp-route-page="@Model.Pagination.TotalPages"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-roleFilter="@Model.RoleFilter">
                        Last
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        // Highlight search terms in the table
        $(document).ready(function() {
            var searchTerm = '@Model.SearchTerm';
            if (searchTerm) {
                $('tbody td:not(:last-child)').each(function() {
                    var text = $(this).text();
                    var regex = new RegExp('(' + searchTerm + ')', 'gi');
                    $(this).html(text.replace(regex, '<mark>$1</mark>'));
                });
            }
        });
    </script>
}