@model Home_Sbdv.Models.UserDetailsViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h2 class="card-title mb-0">Delete User</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone.
                    </div>

                    <h4 class="mb-4">Are you sure you want to delete this user?</h4>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5 class="text-muted">User Information</h5>
                            <dl class="row mt-3">
                                <dt class="col-sm-4">User ID:</dt>
                                <dd class="col-sm-8">@Model.Id</dd>

                                <dt class="col-sm-4">Full Name:</dt>
                                <dd class="col-sm-8">@($"{Model.FirstName} {Model.LastName}")</dd>

                                <dt class="col-sm-4">Email:</dt>
                                <dd class="col-sm-8">@Model.Email</dd>

                                <dt class="col-sm-4">Username:</dt>
                                <dd class="col-sm-8">@Model.Username</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted">Role & Status</h5>
                            <dl class="row mt-3">
                                <dt class="col-sm-4">Role:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @(Model.Role == "admin" ? "bg-danger" :
                                                      Model.Role == "homeowner" ? "bg-primary" : "bg-success")">
                                        @Model.Role
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Contact:</dt>
                                <dd class="col-sm-8">@Model.ContactNumber</dd>

                                <dt class="col-sm-4">Gender:</dt>
                                <dd class="col-sm-8">@Model.Gender</dd>

                                <dt class="col-sm-4">Ownership:</dt>
                                <dd class="col-sm-8">@Model.OwnershipStatus</dd>
                            </dl>
                        </div>
                    </div>

                    <form asp-action="DeleteConfirmed" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash"></i> Delete User
                            </button>
                            <a asp-controller="Dashboard" asp-action="SecurePage" class="btn btn-secondary px-4">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>