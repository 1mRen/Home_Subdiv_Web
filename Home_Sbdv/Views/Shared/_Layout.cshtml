<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Home_Sbdv</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Home_Sbdv.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nav/header.css" asp-append-version="true" />
    
</head>
<body class="d-flex flex-column min-vh-100">
   <header>
    <nav class="navbar navbar-expand-lg p-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark" asp-area="" asp-controller="Home" asp-action="Index">HomeHive</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="#">Features</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="#">Solution</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" href="#">FAQs</a></li>
                    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">About</a></li>
                </ul>
            </div>
            <div class="navbar-nav">
                <a class="btn btn-outline-dark me-2" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn-warning" asp-controller="Account" asp-action="Registration">Sign-up</a>
            </div>
        </div>
    </nav>
</header>

    <div class="flex-grow-1">
        <div class="container">
            <main role="main" class="pb-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
   <footer class="text-center text-lg-start mt-auto">
    <div class="text-center p-3" style="">
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <span>© 2022 Home Hive | All Rights Reserved</span>
            <div class="d-flex gap-3 flex-wrap justify-content-center">
                <a class="text-dark" href="#">Terms of Service</a>
                <a class="text-dark" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                <a class="text-dark" href="#">Contact Us</a>
            </div>
        </div>
    </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>