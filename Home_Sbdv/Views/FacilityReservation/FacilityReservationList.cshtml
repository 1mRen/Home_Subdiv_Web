@model IEnumerable<Home_Sbdv.Models.FacilityReservationViewModel>

@{
    ViewData["Title"] = "Facility Reservations";
}

<h2>Facility Reservations</h2>
<p>
    <a asp-action="Create" class="btn btn-success">Create New Reservation</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Reservation ID</th>
            <th>Facility</th>
            <th>Created By</th>
            <th>Reservation Date</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Status</th>
            
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reservation in Model)
        {
            <tr>
                <td>@reservation.ReservationId</td>
                <td>@reservation.FacilityName</td> <!-- Updated to show Facility Name -->
                <td>@reservation.CreatedByName</td>
                <td>@reservation.ReservationDate.ToString("MM-dd-yy")</td>
                <td>@reservation.StartTime</td>
                <td>@reservation.EndTime</td>
                <td>@reservation.Status</td>
               
                <td>
                    <a asp-action="Details" asp-route-id="@reservation.ReservationId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@reservation.ReservationId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@reservation.ReservationId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>