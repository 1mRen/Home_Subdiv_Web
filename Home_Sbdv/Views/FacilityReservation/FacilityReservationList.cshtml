@model IEnumerable<Home_Sbdv.Models.FacilityReservationViewModel>

@{
    ViewData["Title"] = "Facility Reservations";
}

@if (User.Identity?.IsAuthenticated ?? false)
{
    <h2>Facility Reservations</h2>

    <p>
        <a asp-action="Create" class="btn btn-success">Create New Reservation</a>
    </p>

    <p>
        <a asp-controller="Facility" asp-action="FacilityList" class="btn btn-primary">Back to Facilities</a>
    </p>

    <div class="card">
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Reservation ID</th>
                        <th>Facility</th>
                        <th>Created By</th>
                        <th>Reservation Date</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td>@reservation.ReservationId</td>
                            <td>@reservation.FacilityName</td>
                            <td>@reservation.CreatedByName</td>
                            <td>@reservation.ReservationDate.ToString("MM-dd-yyyy")</td>
                            <td>@reservation.StartTime</td>
                            <td>@reservation.EndTime</td>
                            <td>@reservation.Status</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@reservation.ReservationId" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Edit" asp-route-id="@reservation.ReservationId" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@reservation.ReservationId" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <h3 class="text-danger">You must be logged in to view reservations.</h3>
    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
}
