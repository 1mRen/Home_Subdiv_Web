@model Home_Sbdv.Models.FacilityReservationViewModel

@{
    ViewData["Title"] = "Delete Reservation";
}

<h2 class="text-danger">Delete Reservation</h2>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this reservation?</h4>
    <p>This action cannot be undone.</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ReservationId" />

    <div class="form-group">
        <label class="control-label">Facility Name</label>
        <input class="form-control" value="@Model.FacilityName" disabled />
    </div>

    <div class="form-group">
        <label class="control-label">Reservation Date</label>
        <input class="form-control" value="@Model.ReservationDate.ToString("MM-dd-yyyy")" disabled />
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label class="control-label">Start Time</label>
            <input class="form-control" value="@Model.StartTime" disabled />
        </div>
        <div class="form-group col-md-6">
            <label class="control-label">End Time</label>
            <input class="form-control" value="@Model.EndTime" disabled />
        </div>
    </div>

    <div class="form-group">
        <label class="control-label">Status</label>
        <input class="form-control" value="@Model.Status" disabled />
    </div>

    <br>
    <div class="form-group">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="FacilityReservationList" class="btn btn-secondary">Cancel</a>
    </div>
</form>