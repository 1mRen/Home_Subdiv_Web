@model Home_Sbdv.Models.FacilityReservationViewModel

@{
    ViewData["Title"] = "Delete Reservation";
}

<h2 class="text-danger">Delete Reservation</h2>

<div class="card border-danger mb-3">
    <div class="card-body">
        <div class="alert alert-warning">
            <h4 class="alert-heading">Are you sure you want to delete this reservation?</h4>
            <p>This action <strong>cannot be undone</strong>.</p>
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="ReservationId" />

            <dl class="row">
                <dt class="col-sm-3">Facility Name:</dt>
                <dd class="col-sm-9">@Model.FacilityName</dd>

                <dt class="col-sm-3">Reservation Date:</dt>
                <dd class="col-sm-9">@Model.ReservationDate.ToString("MM-dd-yyyy")</dd>

                <dt class="col-sm-3">Start Time:</dt>
                <dd class="col-sm-9">@Model.StartTime</dd>

                <dt class="col-sm-3">End Time:</dt>
                <dd class="col-sm-9">@Model.EndTime</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-danger">Confirm Delete</button>
                <a asp-action="FacilityReservationList" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
