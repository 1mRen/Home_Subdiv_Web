@model Home_Sbdv.Models.FacilityReservationViewModel

@{
    ViewData["Title"] = "Create Reservation";
    var facilities = ViewBag.FacilityId as SelectList;
}

<h2>Create Reservation</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FacilityId" class="control-label">Select Facility</label>
        <select asp-for="FacilityId" class="form-control" asp-items="facilities" required>
            <option value="">-- Choose a Facility --</option>
        </select>
        <span asp-validation-for="FacilityId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReservationDate" class="control-label">Date</label>
        <input asp-for="ReservationDate" class="form-control" type="date" required />
        <span asp-validation-for="ReservationDate" class="text-danger"></span>
    </div>

    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="StartTime" class="control-label">Start Time</label>
            <input asp-for="StartTime" class="form-control" type="time" required />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>
        <div class="form-group col-md-6">
            <label asp-for="EndTime" class="control-label">End Time</label>
            <input asp-for="EndTime" class="form-control" type="time" required />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
    </div>

    <input type="hidden" asp-for="Status" value="Pending" />

    <br>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Submit</button>
        <a asp-controller="FacilityReservation" asp-action="FacilityReservationList" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
