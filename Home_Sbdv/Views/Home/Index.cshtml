@{
    ViewData["Title"] = "Home Page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Home Hive - Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui/home.css">
</head>
<body data-theme="light">
   
    <div class="position-relative">
        <img src="~/asset/home/Back-Half.png" alt="User Background" class="img-fluid" style="width: 100%; height: auto;">
        <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-75">
            <h1 class="fw-bold">HomeHive Homeowners Association</h1>
            <p class="lead">
                Welcome to HomeHive – where community comes first. We're here to keep you connected, informed, and engaged with everything happening in our neighborhood. From important updates to upcoming events, HomeHive is your trusted space for all things community.
            </p>
        </div>
    </div>

    <!-- Community Features Section -->
    <section class="community-features">
        <div class="container">
            <div class="section-header">
                <h2>Community Features</h2>
                <p>Everything you need to enjoy your community</p>
            </div>

            <div class="features-container">
                <!-- Ticket Submission Card -->
                <div class="feature-card">
                    <img src="~/asset/home/Ticket.png" alt="Woman at laptop" class="feature-image">
                    <div class="feature-content">
                        <h3>Ticket Submission</h3>
                        <p>Directly send your concerns to the association.</p>
                    </div>
                </div>

                <!-- Event Board Card -->
                <div class="feature-card">
                    <img src="~/asset/home/Event.png" alt="People in yellow shirts" class="feature-image">
                    <div class="feature-content">
                        <h3>Event Board</h3>
                        <p>Stay updated with community events, meetings, and important dates</p>
                    </div>
                </div>

                <!-- Facility Reservation Card -->
                <div class="feature-card">
                    <img src="~/asset/home/Court.png" alt="Basketball court" class="feature-image">
                    <div class="feature-content">
                        <h3>Facility Reservation</h3>
                        <p>Stay updated with community events, meetings, and important dates</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- About HOMEHIVE Section -->
    <section class="about-section">
        <div class="container">
            <div class="about-content">
                <div class="about-info">
                    <h2>About HOMEHIVE</h2>
                    <p>HOMEHIVE is dedicated to creating a vibrant, safe, and well-maintained community for all residents. Our homeowners association was established in 2005 and serves over 80 homes in our neighborhood.</p>
                    <p>Our mission is to preserve property values, enhance community living, and foster a strong sense of belonging among all residents.</p>

                    <div class="stats-container">
                        <div class="stat-box">
                            <div class="stat-number">90+</div>
                            <div class="stat-label">Homes</div>
                        </div>

                        <div class="stat-box">
                            <div class="stat-number">15+</div>
                            <div class="stat-label">Annual Events</div>
                        </div>
                    </div>

                    <div class="stats-container mt-3">
                        <div class="stat-box">
                            <div class="stat-number">98%</div>
                            <div class="stat-label">Satisfaction</div>
                        </div>

                        <div class="learn-more-box">
                            <a class="learn-more-btn" asp-area="" asp-controller="Home" asp-action="About">LEARN MORE <i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>

                <div class="board-members">
                    <h3>Board Members</h3>

                    <div class="member">
                        <div class="member-avatar">
                            <img src="~/asset/home/Pres.jpg" alt="Marie Ann Smith">
                        </div>
                        <div class="member-info">
                            <h4>Marie Ann Smith</h4>
                            <p>President</p>
                        </div>
                    </div>

                    <div class="member">
                        <div class="member-avatar">
                            <img src="~/asset/home/VP.jpg" alt="John Doe">
                        </div>
                        <div class="member-info">
                            <h4>John Doe</h4>
                            <p>Vice President</p>
                        </div>
                    </div>

                    <div class="member">
                        <div class="member-avatar">
                            <img src="~/asset/home/TREAS.jpg" alt="Jane Lorenze">
                        </div>
                        <div class="member-info">
                            <h4>Jane Lorenze</h4>
                            <p>Treasurer</p>
                        </div>
                    </div>

                    <div class="member">
                        <div class="member-avatar">
                            <img src="~/asset/home/SECT.jpg" alt="Robert Williams">
                        </div>
                        <div class="member-info">
                            <h4>Robert Williams</h4>
                            <p>Secretary</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Community Amenities Section -->
    <section class="amenities-section" id="amenities">
        <div class="container">
            <div class="section-header">
                <h2>Community Amenities</h2>
                <p>Enjoy these exclusive facilities as a HOMEHIVE resident</p>
            </div>

            <!-- First row of amenities -->
            <div class="amenities-container">
                <div class="amenity-card">
                    <img src="~/asset/home/POOL.png" alt="Swimming Pool" class="amenity-image">
                    <div class="amenity-content">
                        <h3>Swimming Pool</h3>
                        <p>Olympic-sized swimming pool with dedicated lap lanes and a children's splash area.</p>
                        <div class="amenity-status">
                            <i class="bi bi-clock-fill"></i>
                            <span>Open 8AM - 10PM daily</span>
                        </div>
                    </div>
                </div>

                <div class="amenity-card">
                    <img src="~/asset/home/CLUBHOUSE.png" alt="Clubhouse" class="amenity-image">
                    <div class="amenity-content">
                        <h3>Clubhouse</h3>
                        <p>Modern clubhouse with kitchen facilities, meeting rooms, and event space for residents.</p>
                        <div class="amenity-status">
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>Reservations required</span>
                        </div>
                    </div>
                </div>

                <div class="amenity-card">
                    <img src="~/asset/home/PLAYGROUND.png" alt="Parks & Playgrounds" class="amenity-image">
                    <div class="amenity-content">
                        <h3>Parks & Playgrounds</h3>
                        <p>Multiple parks with playgrounds, picnic areas, and walking trails throughout the community.</p>
                        <div class="amenity-status">
                            <i class="bi bi-sun-fill"></i>
                            <span>Available all day</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Second row of amenities -->
            <div class="amenities-container mt-4">
                <div class="amenity-card">
                    <img src="~/asset/home/GYM.png" alt="Fitness Center" class="amenity-image">
                    <div class="amenity-content">
                        <h3>Fitness Center</h3>
                        <p>State-of-the-art equipment with free weights, cardio machines, and dedicated workout areas.</p>
                        <div class="amenity-status">
                            <i class="bi bi-clock-fill"></i>
                            <span>Open 5AM - 11PM daily</span>
                        </div>
                    </div>
                </div>

                <div class="amenity-card">
                    <img src="~/asset/home/Basketball.png" alt="Basketball Court" class="amenity-image">
                    <div class="amenity-content">
                        <h3>Basketball Court</h3>
                        <p>Professional-grade basketball court with night lighting and court reservation system.</p>
                        <div class="amenity-status">
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>Reservations recommended</span>
                        </div>
                    </div>
                </div>

                <div class="amenity-card">
                    <img src="~/asset/home/garden.png" alt="Community Garden" class="amenity-image">
                    <div class="amenity-content">
                        <h3>Community Garden</h3>
                        <p>Dedicated garden plots available for residents to grow their own plants and vegetables.</p>
                        <div class="amenity-status">
                            <i class="bi bi-flower1"></i>
                            <span>Seasonal availability</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Section -->
    <footer class="site-footer">
        <!-- Main Footer -->
        <div class="main-footer">
            <div class="container">
                <div class="footer-content">
                    <!-- Logo and Tagline -->
                    <div class="footer-branding">
                        <div class="footer-logo">
                            <img src="~/asset/HH-logo-long.png" alt="HomeHive Logo" class="logo-img">
                        </div>
                        <p class="tagline">Building a thriving community together, one neighbor at a time.</p>
                        <div class="social-icons">
                            <a href="https://github.com/1mRen/Home_Subdiv_Web" class="social-icon"><i class="bi bi-github"></i></a>
                        </div>
                    </div>

                    <!-- Quick Links -->
                    <div class="footer-links">
                        <h3>Quick Links</h3>
                        <ul>
                            <li><a href="#">Home</a></li>
                            <li><a href="#">About</a></li>
                            <li><a href="#">Announcements</a></li>
                            <li><a href="#amenities">Amenities</a></li>
                            <li><a href="#">Events</a></li>
                            <li><a href="#">Venues</a></li>
                            <li><a href="#">Tickets</a></li>
                        </ul>
                    </div>

                    <!-- Resources -->
                    <div class="footer-links">
                        <h3>Resources</h3>
                        <ul>
                            <li><a href="#">Community Rules</a></li>
                            <li><a href="#">Architectural Guidelines</a></li>
                            <li><a href="#">FAQ</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <div class="container">
                <div class="footer-bottom-content">
                    <p>&copy; 2023 HOMEHIVE Homeowners Association. All rights reserved.</p>
                    <div class="footer-policies">
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                        <a href="#">Cookie Policy</a>
                    </div>
                </div>
            </div>
        </div>
    </footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
