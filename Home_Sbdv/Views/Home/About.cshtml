@{
    ViewData["Title"] = "About Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HomeHive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui/about.css">
</head>

<body data-theme="light">
    <!-- Hero Section -->
    <div class="position-relative">
        <img src="~/asset/about.png" alt="About Us Image" class="img-fluid w-100" style="height: 400px; object-fit: cover;">
        <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-75">
            <h1 class="fw-bold">About Us</h1>
            <p class="lead">
                Discover the community that feels like home - where neighbors become friends and every day brings new opportunities to connect.
            </p>
        </div>
    </div>

    <!-- Subdivision Introduction Section -->
    <section class="intro-section">
        <div class="container">
            <div class="section-header">
                <h2>HOMEHIVE</h2>
                <p>Your Vibrant Community in Cebu</p>
            </div>
            <div class="about-content">
                <div class="about-text">
                    <p>
                        Welcome to Home Hive, a vibrant and thriving community where family, comfort, and security come first.
                        Nestled in the heart of Cebu, our subdivision is a peaceful retreat that blends the tranquility of suburban
                        living with easy access to urban amenities. Whether you are seeking a family-friendly environment or a place to
                        relax and enjoy nature, Home Hive is the ideal choice for you.
                    </p>
                </div>
                <div class="about-stats">
                    <div class="stat-box">
                        <div class="stat-number">2005</div>
                        <div class="stat-label">Established</div>
                    </div>
                    <div class="stat-box">
                        <div class="stat-number">90+</div>
                        <div class="stat-label">Families</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Mission Vision Values Section with cards -->
    <section class="mvv-section">
        <div class="container">
            <div class="features-container">
                <!-- Mission Card -->
                <div class="feature-card">
                    <div class="card-icon">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <div class="feature-content">
                        <h3>Our Mission</h3>
                        <p>
                            At Home Hive, our mission is to provide a safe, secure, and harmonious living environment that fosters community,
                            peace, and growth. We aim to create spaces where families can thrive, individuals can find serenity, and every resident
                            can feel at home.
                        </p>
                    </div>
                </div>

                <!-- Vision Card -->
                <div class="feature-card">
                    <div class="card-icon">
                        <i class="bi bi-binoculars"></i>
                    </div>
                    <div class="feature-content">
                        <h3>Our Vision</h3>
                        <p>
                            Our vision is to be the premier choice for homeowners in the region, a community built on trust, innovation, and a deep
                            respect for nature. We envision a future where Home Hive grows into a vibrant neighborhood with a reputation for excellence
                            and a focus on sustainability and inclusivity.
                        </p>
                    </div>
                </div>

                <!-- Values Card -->
                <div class="feature-card">
                    <div class="card-icon">
                        <i class="bi bi-heart"></i>
                    </div>
                    <div class="feature-content">
                        <h3>Our Values</h3>
                        <p>
                            We prioritize community, sustainability, security, and excellence in everything we do. We believe in fostering
                            a spirit of togetherness, respecting our environment, ensuring the safety of our residents, and striving for
                            excellence in our services and infrastructure.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Values Detailed Section -->
    <section class="values-section">
        <div class="container">
            <div class="section-header">
                <h2>Our Core Values</h2>
                <p>The principles that guide our community</p>
            </div>
            <div class="values-grid">
                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h4>Community</h4>
                    <p>We prioritize the well-being of our residents, fostering a spirit of togetherness, mutual respect, and support.</p>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-tree-fill"></i>
                    </div>
                    <h4>Sustainability</h4>
                    <p>We are committed to responsible development, ensuring that our community respects the environment and minimizes its impact on nature.</p>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4>Security</h4>
                    <p>Your safety is our top priority. We have built Home Hive with advanced security measures to ensure peace of mind for all our residents.</p>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-award"></i>
                    </div>
                    <h4>Excellence</h4>
                    <p>We strive to offer the best in terms of infrastructure, services, and community management, ensuring that every aspect of life in Home Hive exceeds expectations.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose HomeHive Section with image -->
    <section class="choose-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="section-header text-start">
                        <h2>Why Choose HomeHive?</h2>
                        <p>More than just a place to live</p>
                    </div>
                    <div class="choose-content">
                        <p>
                            HomeHive is not just a place to live—it's a place to grow and build memories. Here's why our community is the right
                            choice for you:
                        </p>
                        <ul class="choose-list">
                            <li>
                                <i class="bi bi-geo-alt-fill"></i>
                                <div>
                                    <h5>Prime Location</h5>
                                    <p>Enjoy the best of both worlds—peaceful suburban living with easy access to shopping, schools, and entertainment in Cebu.</p>
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-stars"></i>
                                <div>
                                    <h5>Modern Amenities</h5>
                                    <p>Our subdivision is equipped with modern amenities, including 24/7 security, well-maintained roads, parks, and recreational facilities.</p>
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-people"></i>
                                <div>
                                    <h5>Community Engagement</h5>
                                    <p>From regular events to neighborhood meetings, we foster a strong sense of belonging among all residents.</p>
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-house-heart"></i>
                                <div>
                                    <h5>Quality Homes</h5>
                                    <p>Each home in Home Hive is built with the highest standards of craftsmanship and durability, ensuring that your investment lasts for generations.</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="choose-image">
                        <img src="~/asset/bckg-1.png" alt="Community Image" class="img-fluid rounded shadow">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section">
        <div class="container">
            <div class="contact-wrapper">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="contact-info">
                            <h2>Contact Us</h2>
                            <p>If you would like to learn more about Home Hive or schedule a visit to our subdivision, please feel free to get in touch with us.</p>
                            <div class="contact-details">
                                <div class="contact-item">
                                    <i class="bi bi-envelope"></i>
                                    <div>
                                        <h5>Email</h5>
                                        <p><a href="mailto:info@homehive.com">info@homehive.com</a></p>
                                    </div>
                                </div>
                                <div class="contact-item">
                                    <i class="bi bi-telephone"></i>
                                    <div>
                                        <h5>Phone</h5>
                                        <p>+63 912 345 6789</p>
                                    </div>
                                </div>
                                <div class="contact-item">
                                    <i class="bi bi-geo"></i>
                                    <div>
                                        <h5>Address</h5>
                                        <p>Home Hive Subdivision, Cebu City, Philippines</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="contact-form">
                            <h3>Send Us a Message</h3>
                            <form>
                                <div class="mb-3">
                                    <input type="text" class="form-control" placeholder="Your Name">
                                </div>
                                <div class="mb-3">
                                    <input type="email" class="form-control" placeholder="Your Email">
                                </div>
                                <div class="mb-3">
                                    <textarea class="form-control" rows="4" placeholder="Your Message"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">Send Message</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Section -->
    <footer class="site-footer">
        <!-- Main Footer -->
        <div class="main-footer">
            <div class="container">
                <div class="footer-content">
                    <!-- Logo and Tagline -->
                    <div class="footer-branding">
                        <div class="footer-logo">
                            <img src="~/asset/HH-logo-long.png" alt="HomeHive Logo" class="logo-img">
                        </div>
                        <p class="tagline">Building a thriving community together, one neighbor at a time.</p>
                        <div class="social-icons">
                            <a href="https://github.com/1mRen/Home_Subdiv_Web" class="social-icon"><i class="bi bi-github"></i></a>
                        </div>
                    </div>

                    <!-- Quick Links -->
                    <div class="footer-links">
                        <h3>Quick Links</h3>
                        <ul>
                            <li><a href="#">Home</a></li>
                            <li><a href="#">About</a></li>
                            <li><a href="#">Announcements</a></li>
                            <li><a href="#amenities">Amenities</a></li>
                            <li><a href="#">Events</a></li>
                            <li><a href="#">Venues</a></li>
                            <li><a href="#">Tickets</a></li>
                        </ul>
                    </div>

                    <!-- Resources -->
                    <div class="footer-links">
                        <h3>Resources</h3>
                        <ul>
                            <li><a href="#">Community Rules</a></li>
                            <li><a href="#">Architectural Guidelines</a></li>
                            <li><a href="#">FAQ</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <div class="container">
                <div class="footer-bottom-content">
                    <p>&copy; 2023 HOMEHIVE Homeowners Association. All rights reserved.</p>
                    <div class="footer-policies">
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                        <a href="#">Cookie Policy</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>