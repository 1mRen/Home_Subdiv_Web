@{
    ViewData["Title"] = "About Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HomeHive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/ui/privacy.css">
</head>

<body>
    <div class="container mt-3 position-relative">
        <img src="~/asset/about.png" alt="About Us Image" class="about-us-image">
        <div class="position-absolute top-50 start-0 translate-middle-y">
            <h1 class="about-us-header">About Us</h1>
        </div>
    </div>

    <div class="d-flex align-items-center">
        <div class="media-body">
            <h5 class="mt-5 align-items-center">Center-aligned media</h5>
            <p>
                Welcome to Home Hive, a vibrant and thriving community where family, comfort, and security come first.
                Nestled in the heart of Cebu, our subdivision is a peaceful retreat that blends the tranquility of suburban
                living with easy access to urban amenities.
            </p>
        </div>
    </div>

    <!-- Subdivision Introduction Section -->
    <div class="container mt-5">
        <h2 class="mt-0">HOMEHIVE</h2>
        <p style="font-size: large;">
            Welcome to Home Hive, a vibrant and thriving community where family, comfort, and security come first.
            Nestled in the heart of Cebu, our subdivision is a peaceful retreat that blends the tranquility of suburban
            living with easy access to urban amenities. Whether you are seeking a family-friendly environment or a place to
            relax and enjoy nature, Home Hive is the ideal choice for you.
        </p>
    </div>

    <!-- Our Mission Section -->
    <div class="container mb-5">
        <h2>Our Mission</h2>
        <p>
            At Home Hive, our mission is to provide a safe, secure, and harmonious living environment that fosters community,
            peace, and growth. We aim to create spaces where families can thrive, individuals can find serenity, and every resident
            can feel at home.
        </p>
    </div>

    <!-- Our Vision Section -->
    <div class="container mb-5">
        <h2>Our Vision</h2>
        <p>
            Our vision is to be the premier choice for homeowners in the region, a community built on trust, innovation, and a deep
            respect for nature. We envision a future where Home Hive grows into a vibrant neighborhood with a reputation for excellence
            and a focus on sustainability and inclusivity.
        </p>
    </div>

    <!-- Our Values Section -->
    <div class="container mb-5">
        <h2>Our Values</h2>
        <ul>
            <li><strong>Community:</strong> We prioritize the well-being of our residents, fostering a spirit of togetherness,
                mutual respect, and support.</li>
            <li><strong>Sustainability:</strong> We are committed to responsible development, ensuring that our community
                respects the environment and minimizes its impact on nature.</li>
            <li><strong>Security:</strong> Your safety is our top priority. We have built Home Hive with advanced security
                measures to ensure peace of mind for all our residents.</li>
            <li><strong>Excellence:</strong> We strive to offer the best in terms of infrastructure, services, and community
                management, ensuring that every aspect of life in Home Hive exceeds expectations.</li>
        </ul>
    </div>

    <!-- Why Choose HomeHive Section -->
    <div class="container mb-5">
        <h2>Why Choose HomeHive?</h2>
        <p>
            HomeHive is not just a place to live—it's a place to grow and build memories. Here's why our community is the right
            choice for you:
        </p>
        <ul>
            <li><strong>Prime Location:</strong> Enjoy the best of both worlds—peaceful suburban living with easy access to shopping, schools, and entertainment in Cebu.</li>
            <li><strong>Modern Amenities:</strong> Our subdivision is equipped with modern amenities, including 24/7 security, well-maintained roads, parks, and recreational facilities.</li>
            <li><strong>Community Engagement:</strong> At Home Hive, we believe in the power of community. From regular events to neighborhood meetings, we foster a strong sense of belonging.</li>
            <li><strong>Quality Homes:</strong> Each home in Home Hive is built with the highest standards of craftsmanship and durability, ensuring that your investment lasts for generations.</li>
        </ul>
    </div>

    <!-- Contact Section -->
    <div class="container mb-5">
        <h2>Contact Us</h2>
        <p>If you would like to learn more about Home Hive or schedule a visit to our subdivision, please feel free to get in touch with us.</p>
        <p>Email: <a href="mailto:info@homehive.com">info@homehive.com</a></p>
        <p>Phone: +63 912 345 6789</p>
        <p>Address: Home Hive Subdivision, Cebu City, Philippines</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
