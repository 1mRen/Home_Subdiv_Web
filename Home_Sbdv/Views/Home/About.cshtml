@{
    ViewData["Title"] = "About Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HomeHive</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">
</head>

<body>

    <div class="image-container">
        <div>
            <img class="background-image" src="~/Assests/bckg-1.png" />
        </div>
        <div>
            <img class="top-image" src="~/Assests/fam.png" />
        </div>
        <div class="text">About Us</div>    
    </div>
    

    <div class="d-flex align-items-center">
        <img class="mr-3" src="https://www.mercantile.ph/wp-content/uploads/2023/08/homeowners-protection-plan.jpg/64x64" alt="Generic placeholder image">
        <div class="media-body">
            <h5 class="mt-0">Center-aligned media</h5>
            <p>
                Welcome to Home Hive, a vibrant and thriving community where family, comfort, and security come first.
                Nestled in the heart of Cebu, our subdivision is a peaceful retreat that blends the tranquility of suburban
                living with easy access to urban amenities.
            </p>
        </div>
    </div>
</body>
</html>
